81:     // eslint-disable-next-line react-hooks/set-state-in-effect -- reading an external store once, on purpose
82:     setState((current) => ({ ...current, ...(restored ?? {}), choices: readConsents() }));
83:     setReady(true);
84:   }, [setState]);
86:   useEffect(() => {
87:     if (ready) save(state);
88:   }, [ready, state.complete, state.step, state.answers]);   // eslint-disable-line react-hooks/exhaustive-deps
90:   // The consents are not this state's: they come from the consent store (browser copy of the server's record), so a change made anywhere else
