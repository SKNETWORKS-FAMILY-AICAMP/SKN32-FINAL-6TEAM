24:  * 이 문은 그 403 을 고객이 읽을 수 있는 화면(약관)으로 바꿔 준다.
25:  *   - 동의한 사본이 있으면 바로 연다. 백그라운드에서 서버 기록을 읽어 맞춘다(다른 기기에서 철회했으면 이 문이 닫힌다).
26:  *   - 동의가 없으면 서버 기록을 한 번 확인한 뒤(로그인한 계정은 이미 동의했을 수 있다) 약관 화면으로 보낸다. 서버에 물을 세션이 없는 방문자는 묻지 않고 바로 보낸다.
27:  *   - 서버가 이 앱이 모르는 새 약관 버전이라고 하면(`outdated`) 약관을 다시 받을 수 없으니 새로 고침을 안내한다.
28:  */
29: export function ConsentGate({ children }: { children: ReactNode }) {
30:   const pathname = usePathname();
31:   const router = useRouter();
32:   const t = useT();
33:   const { language } = useSettings();
34:   const ready = useClientReady();
35:   const agreed = useRequiredConsents();
36:   const [result, setResult] = useState<ReconcileResult | null>(null);
37:   const open = OPEN_PATHS.has(pathname);
38: 
39:   useEffect(() => {
40:     if (!ready) return;
41:     let cancelled = false;
42:     const run = () => { void reconcileConsents(language).then((answer) => { if (!cancelled) setResult(answer); }); };
43:     run();
44:     window.addEventListener(CONSENT_REQUIRED_EVENT, run);
45:     window.addEventListener(SESSION_CHANGED_EVENT, run);
46:     return () => { cancelled = true; window.removeEventListener(CONSENT_REQUIRED_EVENT, run); window.removeEventListener(SESSION_CHANGED_EVENT, run); };
47:   }, [ready, language]);
48: 
49:   const needsTerms = ready && !agreed && result !== null && result !== "outdated";
50:   useEffect(() => { if (needsTerms && !open) router.replace(routes.start); }, [needsTerms, open, router]);
51: 
52:   if (open) return <>{children}</>;
53:   if (!ready) return null;
54:   if (result === "outdated") {
55:     return <main className={styles.gate} role="alert">
56:       <h1>{t("약관이 새로 바뀌었어요", "The terms have been updated")}</h1>
57:       <p>{t("이 화면은 옛 버전이에요. 새로 고침해서 새 약관을 확인해 주세요.", "This page is an older version. Reload to see the new terms.")}</p>
58:       <Button variant="primary" onClick={() => window.location.reload()}>{t("새로 고침", "Reload")}</Button>
59:     </main>;
60:   }
61:   if (agreed) return <>{children}</>;
62:   return <main className={styles.gate}><p role="status">{t("약관 동의를 확인하는 중이에요…", "Checking your consent…")}</p></main>;
63: }

