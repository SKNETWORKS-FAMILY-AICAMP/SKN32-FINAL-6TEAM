51: type Saved = z.infer<typeof saved>;
53: function load(): Saved | null {
54:   try {
55:     const raw = window.localStorage.getItem(STORAGE_KEY);
56:     if (!raw) return null;
57:     const parsed = saved.safeParse(JSON.parse(raw));
58:     return parsed.success ? parsed.data : null;
59:   } catch {
60:     return null;
61:   }
62: }
