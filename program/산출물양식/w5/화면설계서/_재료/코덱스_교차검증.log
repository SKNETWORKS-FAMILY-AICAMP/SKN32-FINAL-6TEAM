218: 
219: /**
220:  * A candidate or search result as the `place` value of an edit — what the customer picked, sent back as it came.
221:  * ★null when the result has no coordinates: the server takes a picked place by its coordinates and does not look it up
222:  *   again, so a place without them cannot be picked (the screen leaves its 「이 장소로 바꾸기」 off).
223:  */
224: export function pickedPlace(place: CandidatePlace): PickedPlace | null {
225:   if (typeof place.latitude !== "number" || typeof place.longitude !== "number") return null;
226:   return {
227:     name: place.name,
228:     latitude: place.latitude,
229:     longitude: place.longitude,
230:     source: place.source && PICK_SOURCES.includes(place.source) ? place.source as PickedPlace["source"] : "search",
231:     ...(place.kind ? { kind: place.kind } : {}),
232:     ...(place.content_id ? { content_id: place.content_id } : {}),
233:   };
