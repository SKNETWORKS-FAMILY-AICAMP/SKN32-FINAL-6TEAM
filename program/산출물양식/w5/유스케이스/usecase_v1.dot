digraph UC {
  graph [rankdir=LR, splines=true, nodesep=0.32, ranksep=1.25, pad=0.3, fontname="Malgun Gothic", bgcolor="#ffffff",         label=<<B>triPilot 유스케이스 다이어그램</B> <FONT POINT-SIZE="12" COLOR="#5f6b64">v1 · 2026-10-02 · 실제 API · 코드 기준</FONT>>,         labelloc=t, fontsize=20];
  node [fontname="Malgun Gothic", fontsize=13];
  edge [fontname="Malgun Gothic", fontsize=11, color="#5f6b64", penwidth=1.3, arrowhead=none];
  { rank=min;
    traveler [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>여행자</B></TD></TR></TABLE>>];
    companion [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>동행자</B></TD></TR></TABLE>>];
    aiapp [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>개인 AI 비서 앱</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">우리 API로 연결</FONT>>];
  }
  subgraph cluster_sys { label=<<B>triPilot</B>>; fontsize=17; style="rounded"; color="#2d5f48"; penwidth=2.2; margin=22;
    u01 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-01</FONT><BR/>여행 시작하기<BR/>(언어 · 취향 설문)>];
    u02 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-02</FONT><BR/>계획 올리기>];
    u03 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-03</FONT><BR/>읽힌 일정<BR/>확인 · 고치기>];
    u04 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-04</FONT><BR/>일정 짜 달라고 하기>];
    u05 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-05</FONT><BR/>여행계획서 보기>];
    u06 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-06</FONT><BR/>채팅으로 묻기>];
    u07 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-07</FONT><BR/>바꿔 달라고 하기>];
    u08 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-08</FONT><BR/>문제 알리기<BR/>(늦음 · 휴무)>];
    u09 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-09</FONT><BR/>다른 안 고르기<BR/>· 되돌리기>];
    u10 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-10</FONT><BR/>외부 변화 감시<BR/>(3분마다)>];
    u11 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-11</FONT><BR/>새벽 정기 점검<BR/>(03:00)>];
    u12 [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-12</FONT><BR/><B>일정 조율</B><BR/>(전부 통과할 때까지)>];
    u13 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-13</FONT><BR/>바꾸기 전에 묻기>];
    u14 [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-14</FONT><BR/>변경 알리기>];
    u15 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-15</FONT><BR/>일정 알림 보내기<BR/>(하루 시작 · 출발 시각)>];
    u16 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-16</FONT><BR/>오류 알림 받기<BR/>· 운영 화면 보기>];
  }
  { rank=max;
    timer [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시간»</FONT><BR/><B>시간</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">3분 · 03:00 · 알림 시각</FONT>>];
    watch [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>외부 데이터 6종</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">날씨 · 특보 · 예보 · 재난문자 · 교통 사건 2</FONT>>];
    places [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>장소 · 영업 정보</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">관광공사 · 카카오 · Google · 시간표</FONT>>];
    discord [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>디스코드</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">지금은 팀 시연 채널 하나</FONT>>];
    operator [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>운영자</B></TD></TR></TABLE>>];
  }
  traveler -> companion [arrowhead=empty, arrowsize=1.3, penwidth=1.5, constraint=false];
  traveler -> u01; traveler -> u02; traveler -> u03; traveler -> u06; traveler -> u07; traveler -> u08; traveler -> u09;
  companion -> u05;
  aiapp -> u02; aiapp -> u05; aiapp -> u06; aiapp -> u07; aiapp -> u08; aiapp -> u09;
  u01 -> u02 -> u03 -> u06 -> u07 -> u08 -> u09 -> u05 -> u13 [style=invis, constraint=false];
  u07 -> u12 [style=dashed, arrowhead=vee, xlabel="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  u08 -> u12 [style=dashed, arrowhead=vee, xlabel="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  u12 -> u10 [style=dashed, dir=back, arrowtail=vee, xlabel="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  u12 -> u11 [style=dashed, dir=back, arrowtail=vee, xlabel="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  u12 -> u14 [style=dashed, arrowhead=vee, xlabel="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  u12 -> u15 [style=invis]; u12 -> u16 [style=invis];
  u16 -> u10 -> u11 -> u15 -> u14 [style=invis, constraint=false];
  u02 -> u04 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  u13 -> u12 [style=dashed, arrowhead=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  u10 -> timer; u11 -> timer; u15 -> timer;
  u10 -> watch;
  u11 -> places; u12 -> places;
  u14 -> discord; u15 -> discord;
  u16 -> operator;
}