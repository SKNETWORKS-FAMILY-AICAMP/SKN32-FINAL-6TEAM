digraph UC {
  graph [rankdir=LR, splines=ortho, nodesep=0.42, ranksep=0.95, pad=0.15, bgcolor="transparent", fontname="Malgun Gothic", forcelabels=true];
  node [fontname="Malgun Gothic", fontsize=14];
  edge [color="#606b7e", penwidth=1.15, arrowsize=0.7, fontname="NanumGothicCoding", fontsize=9];
  { rank=min; timer [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_clock.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">시계</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">3분 · 03:00 · 알림 시각 · 1분</FONT></TD></TR></TABLE>>]; }
  subgraph cluster_g { label=<<FONT FACE="NanumGothicCoding" POINT-SIZE="12" COLOR="#727d90">D · 자동 관리 — 시간이 깨워 여행 끝까지 돈다</FONT>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f4f8"; color="#dbe0ea"; penwidth=1; margin=16;
    u10 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="NanumGothicCoding" POINT-SIZE="11" COLOR="#a8720c">UC-10  </FONT><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">외부 변화 감시</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">3분마다</FONT><BR ALIGN="LEFT"/>>];
    u11 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="NanumGothicCoding" POINT-SIZE="11" COLOR="#a8720c">UC-11  </FONT><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">새벽 정기 점검</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">03:00~08:00 · 항목 · 날짜마다 한 번</FONT><BR ALIGN="LEFT"/>>];
    u15 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="NanumGothicCoding" POINT-SIZE="11" COLOR="#a8720c">UC-15  </FONT><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">일정 알림 보내기</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">하루 시작 · 다음 일정 · 출발</FONT><BR ALIGN="LEFT"/>>];
    u16 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="NanumGothicCoding" POINT-SIZE="11" COLOR="#a8720c">UC-16  </FONT><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">오류 알림 받기</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">상시 작업이 연속 실패할 때</FONT><BR ALIGN="LEFT"/>>];
    w2 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">바뀐 값에 걸린 항목 고르기</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">변화 없으면 사건 0 · 알림 0</FONT><BR ALIGN="LEFT"/>>];
    w1 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">소스 수집</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">소스마다 한 번 · 값 · 지문</FONT><BR ALIGN="LEFT"/>>];
    w3 [shape=box, style="rounded,filled,dashed", fillcolor="#ffffff", color="#d6b680", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">대체 소스로 다시 읽기</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">1차 실패 시 · 대체도 실패면 오류</FONT><BR ALIGN="LEFT"/>>];
    o1 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">영업시간 조회</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">계획한 시각에 여나</FONT><BR ALIGN="LEFT"/>>];
    n1 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">출발 시각 계산</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">다음 시작 − 이동 − 여유</FONT><BR ALIGN="LEFT"/>>];
    n2 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">문구틀 번역</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">언어마다 처음 한 번 · 값은 원값</FONT><BR ALIGN="LEFT"/>>];
    n3 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.14,0.07", label=<<FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">알림 배달</FONT><BR ALIGN="LEFT"/><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">3번까지 다시 · 중복 0</FONT><BR ALIGN="LEFT"/>>];
  }
  { rank=max; watch [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_db.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">외부 데이터 6종</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">날씨 · 특보 · 예보 · 재난문자 · 교통 2</FONT></TD></TR></TABLE>>]; google [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_db.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">장소 · 영업 정보</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">같은 행위자 · Google(새벽만)</FONT></TD></TR></TABLE>>]; ai [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_spark.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">AI 모델</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">같은 행위자 · 시험 중</FONT></TD></TR></TABLE>>]; discord [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_bell.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">알림 채널</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">같은 행위자 · 디스코드</FONT></TD></TR></TABLE>>]; operator [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe0ea", penwidth=1, margin="0.10,0.06", label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="4"><TR><TD ROWSPAN="2"><IMG SRC="ic_person.png"/></TD><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="14" COLOR="#161c28">운영자</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Malgun Gothic" POINT-SIZE="11" COLOR="#606b7e">오류 알림만 — 고객 건은 받지 않음</FONT></TD></TR></TABLE>>]; }
  timer -> u10 [arrowhead=none];
  timer -> u11 [arrowhead=none];
  timer -> u15 [arrowhead=none];
  timer -> u16 [arrowhead=none];
  u10 -> w2 [style=dashed, arrowhead=vee];
  u10 -> w1 [style=dashed, arrowhead=vee];
  w1 -> w3 [style=dashed, dir=back, arrowtail=vee, color="#d6b680"];
  u11 -> o1 [style=dashed, arrowhead=vee];
  u15 -> n2 [style=dashed, arrowhead=vee];
  u15 -> n3 [style=dashed, arrowhead=vee];
  u15 -> n1 [style=dashed, arrowhead=vee];
  w1 -> watch [arrowhead=none];
  w3 -> watch [arrowhead=none];
  o1 -> google [arrowhead=none];
  n2 -> ai [arrowhead=none];
  n3 -> discord [arrowhead=none];
  u16 -> operator [arrowhead=none];
}