    u15 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-15</FONT><BR/>일정 알림 보내기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">하루 시작 · 다음 · 출발</FONT>>];
    n1 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<출발 시각 계산<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">시작 − 이동 − 여유</FONT>>];
    n2 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<문구틀 번역<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">언어마다 처음 한 번</FONT>>];
    n3 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<알림 배달<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">3번까지 다시 · 중복 0</FONT>>];
    u16 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-16</FONT><BR/>오류 알림 받기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">상시 작업 연속 실패</FONT>>];
  }
  }
  timer [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시간»</FONT><BR/><B>시간</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">3분 · 03:00 · 알림 시각 · 1분</FONT>>];
  watch [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>외부 데이터 6종</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">날씨 · 특보 · 예보 · 재난문자 · 교통 2</FONT>>];
  info [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>장소 · 영업 · 교통 정보</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">관광공사 · 카카오 · Google · 시간표</FONT>>];
  ai [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>AI 모델</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">시험 중 — 로컬 · API 비교</FONT>>];
  discord [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>디스코드</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">지금은 팀 시연 채널 하나</FONT>>];
  operator [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>운영자</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#5f6b64">오류 알림만</FONT></TD></TR></TABLE>>];
