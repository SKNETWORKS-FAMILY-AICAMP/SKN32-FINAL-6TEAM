digraph UC {
  graph [rankdir=LR, splines=spline, nodesep=0.28, ranksep=0.75, pad=0.4, fontname="Malgun Gothic", bgcolor="#ffffff", newrank=false,         label=<<B>triPilot 유스케이스 — 전체 한 장</B><BR/><FONT POINT-SIZE="13" COLOR="#5f6b64">v2 · 2026-10-02 · 실제 API · 코드 기준 · 구역별 세부는 그림 1~4</FONT>>, labelloc=t, fontsize=22];
  node [fontname="Malgun Gothic", fontsize=12];
  edge [fontname="Malgun Gothic", fontsize=10, color="#5f6b64", penwidth=1.3, arrowhead=none, arrowsize=0.8];
  traveler [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>여행자</B></TD></TR></TABLE>>];
  companion [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>동행자</B></TD></TR></TABLE>>];
  aiapp [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>개인 AI 비서 앱</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">우리 API로 연결</FONT>>];
  req [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>요청하는 쪽</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#5f6b64">여행자 · AI 비서 앱</FONT></TD></TR></TABLE>>];
  subgraph cluster_sys { label=<<B>triPilot</B>>; fontsize=18; style="rounded"; color="#2d5f48"; penwidth=2.4; margin=20;
  subgraph cluster_prep { label=<<B>1 여행 준비</B>>; fontsize=15; style="rounded,dashed"; color="#2d5f48"; penwidth=1.6; margin=14; fontcolor="#2d5f48";
    u01 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-01</FONT><BR/>여행 시작하기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">언어 · 설문 6문항</FONT>>];
    u02 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-02</FONT><BR/>계획 올리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">글 · 사진 · 파일 5개 · 10MB</FONT>>];
    u04 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-04</FONT><BR/>일정 짜 달라고 하기>];
    u03 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-03</FONT><BR/>읽힌 일정 확인 · 고치기>];
    s [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<여행 등록 · 계획서 링크>];
    u05 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-05</FONT><BR/>여행계획서 보기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">로그인 없는 링크 · 늘 최신</FONT>>];
    r [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.5, margin="0.10,0.03", label=<<B>계획 읽기</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">값 · 방법 · 근거(원문 줄)</FONT>>];
    r1 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<정해진 모양 읽기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">코드: 시각 · 일차 · 예약번호</FONT>>];
    r2 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<원문 위치 가리키기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">AI: 남은 줄만</FONT>>];
    r3 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<장소 하나로 정하기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">표 → 별칭 → 오타 → 외부</FONT>>];
    r0 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<사진 받아쓰기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">한 줄씩 · 두 번 대조</FONT>>];
  }
  subgraph cluster_req { label=<<B>2 여행 중 요청</B>>; fontsize=15; style="rounded,dashed"; color="#2d5f48"; penwidth=1.6; margin=14; fontcolor="#2d5f48";
    u06 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-06</FONT><BR/>채팅으로 묻기>];
    u07 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-07</FONT><BR/>바꿔 달라고 하기>];
    u08 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-08</FONT><BR/>문제 알리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">늦음 · 휴무</FONT>>];
    u09 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-09</FONT><BR/>다른 안 고르기 · 되돌리기>];
    q [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.5, margin="0.10,0.03", label=<<B>요청 읽기</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">요청 종류 · 대상 항목</FONT>>];
    g [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<근거 찾기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">규정 · 예약 취소 조건</FONT>>];
    v [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<새 판 저장<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">기준 판이 그대로일 때만</FONT>>];
  }
  subgraph cluster_coord { label=<<B>3 일정 조율 — 전부 통과할 때까지</B>>; fontsize=15; style="rounded,dashed"; color="#c8913a"; penwidth=1.6; margin=14; fontcolor="#c8913a";
    c [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-12</FONT><BR/><B>일정 조율</B>>];
    a1 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<영향받는 항목 추리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">바로 다음 · 오늘 · 이후</FONT>>];
    a2 [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.5, margin="0.10,0.03", label=<<B>담당 에이전트 점검</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">액티비티 → 요식 → 이동</FONT>>];
    x1 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<액티비티 점검<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">운영 · 날씨 · 대기질</FONT>>];
    x2 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<요식 점검<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">영업 · 브레이크 · 라스트오더</FONT>>];
    x3 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<이동 재판정<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">시간표로 앞뒤 제시간?</FONT>>];
    e1 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<다음 후보로 다시<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">통과 못 함 · 후보 남음</FONT>>];
    a3 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<적용<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">근거 대조 → 새 판 1번</FONT>>];
    e2 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-13</FONT><BR/>바꾸기 전에 묻기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">먼저 물어봐 · 고정 · 안전 경보</FONT>>];
    e3 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<못 맞춤 알리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">후보 소진 · 조건 푼 안</FONT>>];
    a4 [shape=ellipse, style=filled, fillcolor="#e5efe8", color="#2d5f48", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-14</FONT><BR/>변경 알리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">알림 1번 · 계획서 새 판</FONT>>];
  }
  subgraph cluster_auto { label=<<B>4 자동 관리</B>>; fontsize=15; style="rounded,dashed"; color="#2f6c9a"; penwidth=1.6; margin=14; fontcolor="#2f6c9a";
    u10 [shape=ellipse, style=filled, fillcolor="#fffdf7", color="#7f8f86", penwidth=1.5, margin="0.10,0.03", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-10</FONT><BR/>외부 변화 감시<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">3분마다</FONT>>];
    w1 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<소스 수집<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">소스마다 한 번</FONT>>];
    w3 [shape=ellipse, style=filled, fillcolor="#fbf4e6", color="#c8913a", penwidth=1.5, margin="0.10,0.03", label=<대체 소스로 다시 읽기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">1차 실패 시</FONT>>];
    w2 [shape=ellipse, style=filled, fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.5, margin="0.10,0.03", label=<바뀐 값에 걸린 항목 고르기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">변화 없으면 사건 0</FONT>>];
