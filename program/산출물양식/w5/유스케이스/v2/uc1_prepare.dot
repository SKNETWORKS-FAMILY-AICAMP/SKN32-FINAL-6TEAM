digraph UC {
  graph [rankdir=LR, splines=spline, nodesep=0.42, ranksep=0.9, pad=0.35, fontname="Malgun Gothic", bgcolor="#ffffff",         label=<<B>그림 1 · 여행 준비 — 계획을 받아 일정으로 읽는다</B><BR/><FONT POINT-SIZE="12" COLOR="#5f6b64">계획 읽기는 에이전트가 아니라 매니저(코어)의 처리 단계</FONT>>, labelloc=t, fontsize=19, ordering=out];
  node [fontname="Malgun Gothic", fontsize=13];
  edge [fontname="Malgun Gothic", fontsize=11, color="#5f6b64", penwidth=1.4, arrowhead=none, arrowsize=0.9];
  { rank=min; traveler [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>여행자</B></TD></TR></TABLE>>]; companion [shape=none, margin=0, label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="2"><TR><TD><IMG SRC="actor.png"/></TD></TR><TR><TD><B>동행자</B></TD></TR></TABLE>>]; aiapp [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>개인 AI 비서 앱</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">우리 API로 연결</FONT>>]; }
  subgraph cluster_sys { label=<<B>triPilot</B>>; fontsize=16; style="rounded"; color="#2d5f48"; penwidth=2.2; margin=20;
    u01 [shape=ellipse, style="filled", fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-01</FONT><BR/>여행 시작하기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">언어 · 설문 6문항</FONT>>];
    u02 [shape=ellipse, style="filled", fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-02</FONT><BR/>계획 올리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">글 · 사진 · 파일 5개 · 10MB</FONT>>];
    u03 [shape=ellipse, style="filled", fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-03</FONT><BR/>읽힌 일정 확인 · 고치기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">고치기 · 빼기 → 등록</FONT>>];
    u05 [shape=ellipse, style="filled", fillcolor="#fffdf7", color="#7f8f86", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-05</FONT><BR/>여행계획서 보기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">로그인 없는 링크 · 늘 최신</FONT>>];
    u04 [shape=ellipse, style="filled", fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-04</FONT><BR/>일정 짜 달라고 하기>];
    r [shape=ellipse, style="filled", fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, margin="0.12,0.04", label=<<B>계획 읽기</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">항목마다 값 · 방법 · 근거(원문 줄)</FONT>>];
    r1 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<정해진 모양 읽기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">코드: 시각 · 일차 · 날짜 · 예약번호</FONT>>];
    r2 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<원문 위치 가리키기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">AI: 남은 줄만 · 원문에 없으면 버림</FONT>>];
    r3 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<장소 하나로 정하기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">우리 표 → 별칭 → 오타 → 카카오 · 관광공사</FONT>>];
    r0 [shape=ellipse, style="filled", fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, margin="0.12,0.04", label=<사진 받아쓰기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">한 줄씩 · 두 번 대조</FONT>>];
    s [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<여행 등록 · 계획서 링크 만들기>];
  }
  { rank=max; ai [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>AI 모델</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">시험 중 — 로컬 · API 비교</FONT>>]; place [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>장소 정보</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">우리 표 · 카카오 · 관광공사 · Places</FONT>>]; }
  traveler -> companion [arrowhead=empty, arrowsize=1.3, penwidth=1.5, constraint=false];
  traveler -> u01;
  traveler -> u02;
  traveler -> u03;
  companion -> u05;
  aiapp -> u02;
  aiapp -> u05;
  u02 -> u04 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  u02 -> r [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  r -> r1 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  r -> r2 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  r -> r3 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  r -> r0 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  u03 -> s [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  r2 -> ai;
  r0 -> ai;
  r3 -> place;
  u01 -> u02 -> u03 -> u05 [style=invis, constraint=false];
}