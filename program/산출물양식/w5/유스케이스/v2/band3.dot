digraph UC {
  graph [rankdir=LR, splines=spline, nodesep=0.42, ranksep=0.9, pad=0.2, fontname="Malgun Gothic", bgcolor="transparent", ordering=out];
  node [fontname="Malgun Gothic", fontsize=13];
  edge [fontname="Malgun Gothic", fontsize=11, color="#5f6b64", penwidth=1.4, arrowhead=none, arrowsize=0.9];
  subgraph cluster_sys { label=<<B>triPilot · 3 일정 조율 — 전부 통과할 때까지</B>>; fontsize=16; fontcolor="#c8913a"; style="rounded"; color="#c8913a"; penwidth=2.2; margin=20;
    c [shape=ellipse, style="filled", fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-12</FONT><BR/><B>일정 조율</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">UC-07 · 08 · 10 · 11 이 반드시 부른다</FONT>>];
    a1 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<영향받는 항목 추리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">바로 다음 · 오늘 · 이후 전부</FONT>>];
    a2 [shape=ellipse, style="filled", fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, margin="0.12,0.04", label=<<B>담당 에이전트 점검</B><BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">액티비티 → 요식 → 이동 · 앞 초안을 넘김</FONT>>];
    a3 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<적용<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">근거 대조(기준 판 · 항목 · 장소) → 새 판 1번</FONT>>];
    a4 [shape=ellipse, style="filled", fillcolor="#e5efe8", color="#2d5f48", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-14</FONT><BR/>변경 알리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">알림 1번 · 계획서 새 판</FONT>>];
    x1 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<액티비티 점검<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">운영일 · 시간 · 날씨 · 대기질</FONT>>];
    x2 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<요식 점검<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">영업 · 브레이크 · 라스트오더</FONT>>];
    x3 [shape=ellipse, style="filled", fillcolor="#f3f6f1", color="#9fb0a6", penwidth=1.6, margin="0.12,0.04", label=<이동 재판정<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">시간표로 앞뒤 구간 제시간?</FONT>>];
    e1 [shape=ellipse, style="filled", fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, margin="0.12,0.04", label=<다음 후보로 다시<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">전부 통과 못 함 · 후보 남음</FONT>>];
    e2 [shape=ellipse, style="filled", fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, margin="0.12,0.04", label=<<FONT POINT-SIZE="10" COLOR="#7d867f">UC-13</FONT><BR/>바꾸기 전에 묻기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">설문 「먼저 물어봐」 · 고정 · 안전 경보</FONT>>];
    e3 [shape=ellipse, style="filled", fillcolor="#fbf4e6", color="#c8913a", penwidth=1.6, margin="0.12,0.04", label=<못 맞춤 알리기<BR/><FONT POINT-SIZE="10" COLOR="#5f6b64">후보 소진 · 조건 푼 안 제시</FONT>>];
  }
  { rank=max; info [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>장소 · 영업 · 교통 정보</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">같은 액터 · 관광공사 · 카카오 · Google · 시간표</FONT>>]; discord [shape=box, style="rounded,filled", fillcolor="#f6ead4", color="#c8913a", penwidth=1.6, label=<<FONT POINT-SIZE="11" COLOR="#8a5f1c">«시스템»</FONT><BR/><B>디스코드</B><BR/><FONT POINT-SIZE="11" COLOR="#5f6b64">지금은 팀 시연 채널 하나</FONT>>]; }
  c -> a4 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  c -> a3 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  c -> a2 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  c -> a1 [style=dashed, arrowhead=vee, label="«include»", fontcolor="#2d5f48", color="#2d5f48"];
  a2 -> x1 [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.5];
  a2 -> x2 [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.5];
  a2 -> x3 [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.5];
  a2 -> e1 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  a3 -> e2 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  c -> e3 [style=dashed, dir=back, arrowtail=vee, label="«extend»", fontcolor="#8a5f1c", color="#c8913a"];
  x1 -> info;
  x2 -> info;
  x3 -> info;
  a4 -> discord;
}