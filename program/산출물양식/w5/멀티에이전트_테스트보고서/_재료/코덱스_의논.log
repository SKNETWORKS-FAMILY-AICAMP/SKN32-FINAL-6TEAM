9c\uc758 \uadfc\uac70(\uc790\ub9ac\ud45c\u00b7\uc870\uac74\u00b7\ud6c4\ubcf4 \uc218) \u2014 \uac10\uc0ac\u00b7\uc7ac\ud604\uc6a9 \uae30\ub85d\uc5d0 \uc4f4\ub2e4\n24: \n25: \n26: def run_one(i, cfg, qs, items, out, latweave=False):\n27:     q = qs[i]['q']\n28:     a = analyze(q)\n29:     tt = a['tt']\n30:     rs = rule_slots(tt, items)\n31:     if rs['day'] is None:\n32:         rs['day'] = rule_slots(q, items)['day']\n33:     calls = []\n34:     anchor = None\n35:     if rs['rel'] is not None:\n36:         calls.append(('anchor', cfg[1]))\n37:         anchor = out[cfg[1]]['anchor_excl'][i] if a['negation'] else out[cfg[1]]['anchor_tt'][i]\n38:     slots = {k: rs[k] for k in ('day', 'pos', 'kind', 'meal', 'rel', 'kw', 'nextday')}\n39:     slots['anchor'] = anchor\n40:     r = resolve(items, slots, latweave)\n41:     LAST.clear()\n42:     LAST.update({'slots': slots, 'why': r[2] if len(r) > 2 else None})\n43:     if r[0] == 'clarify':                    # \ud6c4\ubcf4 2~5\uac1c \u2014 \uc9da\uae30 \uc804\ubb38\uac00\uac00 \uadf8 \uc548\uc5d0\uc11c \uace0\ub974\uba74 \uadf8 \ub2f5, \ud6c4\ubcf4 \ubc16\uc774\uac70\ub098 \ubabb \uace0\ub974\uba74 \ubaa8\ub378\uc774 \ucc0d\uc9c0 \uc54a\uace0 \ub418\ubb3b\ub294\ub2e4\n44:         calls.append(('point', cfg[2]))\n45:         pp = out[cfg[2]]['point'][i]\n46:         if pp in r[1]:\n47:             LAST['why'] += f' \u2014 \ud6c4\ubcf4 \uc548\uc5d0\uc11c \uc9da\uae30 \uc804\ubb38\uac00\uac00 {pp} \uc120\ud0dd'\n48:             return pp, calls, 'struct+point'\n49:         return r, calls, 'clarify'\n50:     if r[0] == 'item':\n51:         return r[1], calls, 'struct'\n52:     if r[0] == 'none':\n53:         return None, calls, 'struct'\n54:     calls.append(('gate', cfg[0]))\n55:     if not out[cfg[0]]['gate2'][i]:\n56:         return None, calls, 'gate'\n57:     calls.append(('point', cfg[2]))\n58:     p = out[cfg[2]]['point'][i]\n59:     if p is not None:                       # \uc9da\uc740 \ud56d\ubaa9\uc774 \ubb38\uc7a5\uacfc \uc815\ub9d0 \ub9de\ub294\uc9c0 \uac19\uc740 \ubaa8\ub378\uc774 \ud55c \ubc88 \ub354 \ud655\uc778(verify)\n60:         calls.append(('verify', cfg[2]))\n61:         if out[cfg[2]]['verify'][i] is False:\n62:             return None, calls, 'verify'\n63:     return p, calls, 'point'\n64: \n65: \n66: def evaluate(cfg, qs, items, out, idx):\n67:     ok = bad = miss = 0\n68:     bt = defaultdict(int)\n69:     sec = 0.0\n70:     src = defaultdict(int)\n71:     for i in idx:\n72:         p, calls, how = run_one(i, cfg, qs, items, out)\n73:         g = qs[i]['gold']\n74:         ok += (p == g); bad += (p is not None and p != g); miss += (p is None and g is not None)\n75:         bt[qs[i]['type']] += (p == g)\n76:         sec += sum(out[m]['sec_per_q'] / 4 for _, m in calls)\n77:         src[how] += 1\n78:     return ok, bad, miss, bt, sec / len(idx), dict(src)\n79: \n80: \n81: if __name__ == '__main__':\n82:     job = sys.argv[1] if len(sys.argv) > 1 else 'heavy'\n83:     qs, items, out = load(job)\n84:     dev = [i for i, x in enumerate(qs) if x.get('split') == 'dev']\n85:     held = [i for i, x in enumerate(qs) if x.get('split') == 'held']\n86:     cfgs = list(itertools.product(MODELS, repeat=3))\n87:     print(f'## {job} \u2014 dev {len(dev)} \u00b7 held {len(held)}   (\uc5ed\ud560 \uc21c\uc11c: gate \u00b7 anchor \u00b7 point)')\n88:     rows = []\n89:     for cfg in cfgs:\n90:         d = evaluate(cfg, qs, items, out, dev)\n91:         h = evaluate(cfg, qs, items, out, held)\n92:         rows.append((cfg, d, h))\n93:         print(f\"  {'/'.join(m.split(':')[1] for m in cfg):<14} dev {d[0]}/{len(dev)} \u00b7 held {h[0]}/{len(held)}={h[0] / len(held):.0%} \uc5c9\ub6b1 {h[1]} \ubabb \ucc3e\uc74c {h[2]} \u00b7 \ud3c9\uade0 \uc57d {h[4]:.1f}\ucd08/\uc9c8\ubb38(\ucd94\uc815) \u00b7 \ucc98\ub9ac {h[5]}\")\n94:     best = max(rows, key=lambda r: (r[1][0], -r[1][1], -sum(m == 'gemma4:12b' for m in r[0])))\n95:     print('\\n\uac1c\ubc1c\uc6a9 \uc815\ud655\ub3c4\ub85c \