h.join(HERE, f'fixtures/{s}.json'), encoding='utf-8'))['sets'][s] for s in SETS}\n14: KEYS = [(s, i) for s in SETS for i in range(len(FX[s]['qs']))]\n15: GSET = {(s, i): frozenset(GS[s][str(i)]) for s, i in KEYS}\n16: GOLD = {(s, i): FX[s]['qs'][i]['gold'] for s, i in KEYS}\n17: TYPE = {(s, i): FX[s]['qs'][i]['type'] for s, i in KEYS}\n18: COMP = [k for k in KEYS if TYPE[k] == 'compound_intent']\n19: NONC = [k for k in KEYS if TYPE[k] != 'compound_intent']\n20: assert len(KEYS) == 835 and len(COMP) == 66 and len(NONC) == 769, (len(KEYS), len(COMP), len(NONC))\n21: \n22: \n23: def score_multi(picks):\n24:     \"\"\"picks: {key: list[int]} \u2192 (C \uc804\uccb4, C \ube44\ubcf5\ud569, C \ubcf5\ud569, A \ubcf5\ud569, B \ubcf5\ud569)\"\"\"\n25:     c_all = c_non = c_comp = a_comp = b_comp = 0\n26:     for k in KEYS:\n27:         p = picks.get(k)\n28:         ps = frozenset(p or [])\n29:         hit = ps == GSET[k]\n30:         c_all += hit\n31:         if k in COMP:\n32:             c_comp += hit\n33:             a_comp += bool(p) and p[0] == GOLD[k]\n34:             b_comp += bool(ps & GSET[k])\n35:         else:\n36:             c_non += hit\n37:     return c_all, c_non, c_comp, a_comp, b_comp\n38: \n39: \n40: def score_single(pick):\n41:     \"\"\"\ud55c \ud56d\ubaa9 \ubaa8\ub378: \uc9d1\ud569 = {pick} (\uc5c6\uc74c\uc774\uba74 \ube48 \uc9d1\ud569)\"\"\"\n42:     return score_multi({k: ([] if pick.get(k) is None else [pick[k]]) for k in KEYS})\n43: \n44: \n45: def fnum(x):\n46:     return None if x in ('', None) else int(float(x))\n47: \n48: \n49: rows = list(csv.DictReader(open(os.path.join(HERE, 'results/export/per_question.csv'), encoding='utf-8-sig')))\n50: SINGLE = defaultdict(dict)\n51: for r in rows:\n52:     if r['set'] in SETS:\n53:         SINGLE[r['model']][(r['set'], int(r['q_index']))] = fnum(r['pick'])\n54: E4BT = {}\n55: for s in SETS:\n56:     ev = json.load(open(os.path.join(HERE, f'results/_pull/distill_eval/eval_r16e2_{s}.json'), encoding='utf-8'))\n57:     for i, p in enumerate(ev['r16e2#lora']['picks']):\n58:         E4BT[(s, i)] = p\n59: SINGLE['E4B-\uac00\ub974\uce68'] = E4BT\n60: \n61: \n62: def find(prefix):\n63:     c = [m for m in SINGLE if m.startswith(prefix)]\n64:     assert len(c) == 1, (prefix, c)\n65:     return c[0]\n66: \n67: \n68: MULTI = {}\n69: for tag, label in (('claude_opus_5_5', 'Claude Opus 5.5(\ubb38\uc81c\ubcc4 CLI\u00b7\uc0dd\uac01 \ub054, \ud074\ub77c\uc6b0\ub4dc)'), ('claude_fable_5_1', 'Claude Fable 5.1(\ubb38\uc81c\ubcc4 CLI\u00b7\uc0dd\uac01 \ub054, \ud074\ub77c\uc6b0\ub4dc)')):\n70:     d = {}\n71:     for s in SETS:\n72:         f = os.path.join(HERE, f'results/claude_{tag}_{s}_multi.json')\n73:         if not os.path.exists(f):\n74:             break\n75:         rr = json.load(open(f, encoding='utf-8'))['rows']\n76:         for i in range(len(FX[s]['qs'])):\n77:             d[(s, i)] = rr[str(i)].get('picks') or []\n78:     else:\n79:         MULTI[label] = d\n80: d = {}\n81: for s in SETS:\n82:     f = os.path.join(HERE, f'results/_pull/multi/llm_{s}_multi_out.json')\n83:     if os.path.exists(f):\n84:         pk = json.load(open(f, encoding='utf-8'))['gemma4:12b#multi']['picks']\n85:         for i, p in enumerate(pk):\n86:             d[(s, i)] = p\n87: if len(d) == 835:\n88:     MULTI['Gemma 12B(\uc62c\ub77c\ub9c8, \u300c\ub458 \ub2e4 \ucc3e\uae30\u300d \uc9c0\uc2dc)'] = d\n89: \n90: print('# C \ucc44\uc810\uae4c\uc9c0 \ub123\uc740 \ube44\uad50 \u2014 835\ubb38\uc81c(\uc694\uccad \ub458 66 \ud3ec\ud568)\\n')\n91: print('\ucc44\uc810: A \uba3c\uc800 \ub9d0\ud55c \ud56d\ubaa9 \u00b7 B \ub9d0\ud55c \ud56d\ubaa9 \uc911 \ud558\ub098\ub77c\ub3c4 \u00b7 C \uace0\ub978 \uc9d1\ud569\uc774 \uc815\ub2f5 \uc9d1\ud569\uacfc \uc815\ud655\ud788 \uac19\uc74c. \ud55c \ud56d\ubaa9 \ubaa8\ub378\uc740 \uc694\uccad \ub458 C = 0(\uc9d1\ud569 \ud06c\uae30\uac00 \ub2e4\ub984).\\n')\n92: print('## 1. \ud55c \ud56d\ubaa9\ub9cc \uace0\ub974\ub294 \ubaa8\ub378 (C \uc804\uccb4 = \uc694\uccad \ub458 \uc81c\uc678 \uc815\ub2f5 / 835)')\n93: print(f'{\"\ubaa8\ub378\":<44}{\"C \uc804\uccb4(835)\":>14}{\"\uc694\uccad \ub458 \uc81c\uc678(769)\":>18}{\"\uc694\uccad \ub458 A\":>10}{\"\uc694\uccad \ub458 B\":>10}{\"\uc694\uccad \ub458 C\":>10}')\n94: singles = [('E4B-\uac00\ub974\uce68', 'E4B-\uac00\ub974\uce68'), ('Gemma 4 E4B QAT', find('Gemma 4 E4B QAT')), ('Decider-12B bf16', find('Decider-12B bf16')), ('Winnow-12B Q8', find('Winnow-12B Q8')),\n95:            ('Gemma 4 26B(\uc62c\ub77c\ub9c8)', find('Gemma 4 26B')), ('Qwen3.8 27B(\uc62c\ub77c\ub9c8)', find('Qwen3.8 27B')), ('OpenJev 26B', find('OpenJev 26B')), ('decider-chat 31B', find('decider-chat Gemma4-31B'))]\n96: for label, m in singles:\n97:     c_all, c_non, c_comp, a, b = score_single(SINGLE[m])\n98:     print(f'{label:<44}{c_all:>8}/835 {100 * c_all / 835:4.1f}%{c_non:>10}/769{a:>9}/66{b:>8}/66{c_comp:>8}/66')\n99: \n100: print('\\n## 2. \uc5ec\ub7ec \ud56d\ubaa9\uc744 \ub0bc \uc218 \uc788\ub294 \ubaa8\ub378 (\uc9d1\ud569 \ucd9c\ub825)')\n101: print(f'{\"\ubaa8\ub378\":<44}{\"C \uc804\uccb4(835)\":>14}{\"\uc694\uccad \ub458 \uc81c\uc678(769)\":>18}{\"\uc694\uccad \ub458 A\":>10}{\"\uc694\uccad \ub458 B\":>10}{\"\uc694\uccad \ub458 C\":>10}')\n102: for label, d in MULTI.items():\n103:     c_all, c_non, c_comp, a, b = score_multi(d)\n104:     print(f'{label:<44}{c_all:>8}/835 {100 * c_all / 835:4.1f}%{c_non:>10}/769{a:>9}/66{b:>8}/66{c_comp:>8}/66')\n105: \n106: print('\\n## 3. \uacb0\uc815 \ubaa8\ub378 \uc624\ud504\ub77c\uc778 \u300c\ud655\ub960 \u2265 \u03c4 \uc778 \ud56d\ubaa9 \uc9d1\ud569\u300d (\uae30\uc874 c_offline.csv \u2014 \uac1c\ubc1c mix8+9 \uc5d0\uc11c \u03c4 \ub97c \uace8\ub77c \uc2dc\ud5d8 mix10~12)')\n107: off = list(csv.DictReader(open(os.path.join(HERE, 'results/export/c_offline.csv'), encoding='utf-8-sig')))\n108: by = defaultdict(lambda: defaultdict(lambda: [0, 0, 0, 0]))\n109: for r in off:\n110:     k = (r['model'], r['tau'])\n111:     comp = r['compound'] == 'True'\n112:     by[k]['all'][0] += int(r['exact'])\n113:     by[k]['all'][1] += 1\n114:     if comp:\n115:         by[k]['comp'][0] += int(r['exact'])\n116:         by[k]['comp'][1] += 1\n117: best = {}\n118: for (m, tau), v in by.items():\n119:     if v['all'][1] == 835 and (m not in best or v['all'][0] > best[m][1]['all'][0]):\n120:         best[m] = (tau, v)\n121: print(f'{\"\ubaa8\ub378(\uc804\uccb4 835 \uc5d0\uc11c C \uac00 \uac00\uc7a5 \ub192\uc740 \u03c4 \u2014 \ub099\uad00\uc801)\":<56}{\"\u03c4\":>6}{\"C \uc804\uccb4\":>14}{\"\uc694\uccad \ub458 C\":>12}')\n122: for m, (tau, v) in sorted(best.items(), key=lambda x: -x[1][1]['all'][0]):\n123:     print(f'{m:<56}{tau:>6}{v[\"all\"][0]:>8}/835 {100 * v[\"all\"][0] / 835:4.1f}%{v[\"comp\"][0]:>8}/{v[\"comp\"][1]}')\n124: \n125: print('\\n## 4. \uc694\uccad \ub458\uc744 \ubbf8\ub9ac \uc54c\uc544\ubcf4\ub294 \uaddc\uce59(\uc9c8\ubb38\uc5d0 \uc11c\ub85c \ub2e4\ub978 \uc77c\uc815 \ud56d\ubaa9 \uc774\ub984 \uc870\uac01\uc774 \ub458 \uc774\uc0c1 \ub4e4\uc5c8\ub098) \u2014 \uc788\ub2e4\uba74 \ud55c \ud56d\ubaa9 \ubaa8\ub378 + \uc9d1\ud569 \ubaa8\ub378\uc744 \uc774\uc5b4 \ubd99\uc77c \uc218 \uc788\ub2e4')\n126: \n127: \n128: def lcs(a, b):\n129:     best = 0\n130:     prev = [0] * (len(b) + 1)\n131:     for i in range(1, len(a) + 1):\n132:         cur = [0] * (len(b) + 1)\n133:         for j in range(1, len(b) + 1):\n134:             if a[i - 1] == b[j - 1]:\n135:                 cur[j] = prev[j - 1] + 1\n136:                 best = max(best, cur[j])\n137:         prev = cur\n138:     return best\n139: \n140: \n141: def n_items_named(s, i, thr):\n142:     job = FX[s]\n143:     q = ''.join(job['qs'][i]['q'].split())\n144:     hit = 0\n145:     for it in job['items']:\n146:         nm = [''.join(str(it.get(f, '')).split()) for f in ('title', 'place')]\n147:         if any(len(n) >= 2 and lcs(q, n) >= thr for n in nm):\n148:             hit += 1\n149:     return hit\n150: \n151: \n152: for thr in (3, 4):\n153:     f = {k: n_items_named(k[0], k[1], thr) for k in KEYS}\n154:     for need in (2,):\n155:         tp = sum(1 for k in COMP if f[k] >= need)\n156:         fp = sum(1 for k in NONC if f[k] >= need)\n157:         print(f'  \uc774\ub984 \uc870\uac01(\u2265{thr}\uae00\uc790)\uc774 \ud56d\ubaa9 {need}\uac1c \uc774\uc0c1\uc5d0 \uac78\ub9bc: \uc694\uccad \ub458 {tp}/66 \uc744 \uc7a1\uace0, \uc694\uccad \ub458\uc774 \uc544\ub2cc\ub370 \uac78\ub9b0 \uac83 {fp}/769 (\uc815\ubc00\ub3c4 {tp / max(1, tp + fp):.2f} \u00b7 \uc7ac\ud604\uc728 {tp / 66:.2f})')\n158: \n159: print('\\n## 5. \uc774\uc5b4 \ubd99\uc774\uae30 \ubaa8\uc758: \uc694\uccad \ub458\uc774\ub77c\uace0 \uc54c\uc544\ubcf8 \uc9c8\ubb38\ub9cc \uc9d1\ud569 \ubaa8\ub378\uc5d0\uac8c, \ub098\uba38\uc9c0\ub294 \uac00\ub974\uce5c E4B \uc5d0\uac8c (\uaddc\uce59 = \uc774\ub984 \uc870\uac01 \u22653\uae00\uc790\uac00 \ud56d\ubaa9 2\uac1c \uc774\uc0c1)')\n160: f3 = {k: n_items_named(k[0], k[1], 3) for k in KEYS}\n161: for label, d in MULTI.items():\n162:     hy = {k: (d[k] if f3[k] >= 2 else ([] if E4BT[k] is None else [E4BT[k]])) for k in KEYS}\n163:     c_all, c_non, c_comp, a, b = score_multi(hy)\n164:     print(f'  \uac00\ub974\uce5c E4B + {label[:30]:<30} C \uc804\uccb4 {c_all}/835 = {100 * c_all / 835:.1f}% \u00b7 \uc694\uccad \ub458 C {c_comp}/66 \u00b7 \uc694\uccad \ub458 \uc81c\uc678 {c_non}/769')\n165: base = score_single(E4BT)\n166: print(f'  (\ucc38\uace0) \uac00\ub974\uce5c E4B \ub2e8\ub3c5 C \uc804\uccb4 {base[0]}/835 = {100 * base[0] / 835:.1f}%')\n167: # \uc624\ub77c\ud074 \uaddc\uce59: \uc694\uccad \ub458\uc744 \uc644\ubcbd\ud788 \uc54c\uc544\ubcf8\ub2e4\uace0 \uac00\uc815\ud55c \uc0c1\ud55c\n168: for label, d in MULTI.items():\n169:     hy = {k: (d[k] if k in COMP else ([] if E4BT[k] is None else [E4BT[k]])) for k in KEYS}\n170:     c_all, c_non, c_comp, a, b = score_multi(hy)\n171:     print(f'  [\uc0c1\ud55c: \uc694\uccad \ub458\uc744 \uc644\ubcbd\ud788 \uac00\ub824\ub0b8\ub2e4\uace0 \uac00\uc815] \uac00\ub974\uce5c E4B + {label[:30]:<30} C \uc804\uccb4 {c_all}/835 = {100 * c_all / 835:.1f}% \u00b7 \uc694\uccad \ub458 C {c_comp}/66')\n172: \n173: print('\\n## 6. \ucd9c\uc81c\uc790\uc640 \ud478\ub294 \ucabd\uc744 \uac00\ub978 C \u2014 Codex(Luna\u00b7Sol\u00b7Astra)\uac00 \ud47c \ub458 \ub2e4 \ucc3e\uae30(\u00a784) \u00b7 \ud55c \uc904\uc5d0 \u300c\ucd9c\uc81c\uc790 \ud3b8\ud5a5\u300d \ud45c\uc2dc')\n174: print('mix8~11 = Codex \uac00 \uc4f4 \ubb38\uc81c(Codex \ud480\uc774\ub294 \ucd9c\uc81c\uc790 \ud3b8\ud5a5 \u00b7 Claude \ud480\uc774\ub294 \uc0c1\ub300\uc801\uc73c\ub85c \uacf5\uc815) \u00b7 mix12 = Claude \uac00 \uc4f4 \ubb38\uc81c(Claude \ud480\uc774\ub294 \ucd9c\uc81c\uc790 \ud3b8\ud5a5 \u00b7 Codex \ud480\uc774\ub294 \uc0c1\ub300\uc801\uc73c\ub85c \uacf5\uc815). \uc815\ub2f5 \uc9d1\ud569(gold_sets)\uc740 \uc804\ubd80 Claude \uc791\uc131 \u2014 Claude \ud480\uc774\ub294 \uc815\ub2f5 \ud0a4\ub3c4 \uac19\uc740 \uc190.')\n175: CODEX = {}\n176: for m in ('gpt-6-luna', 'gpt-6-sol', 'gpt-6-astra'):\n177:     d = {}\n178:     for s in SETS:\n179:         f = os.path.join(HERE, f'results/codexcli_{m}_{s}_multi.json')\n180:         if os.path.exists(f):\n181:             rr = json.load(open(f, encoding='utf-8'))['rows']\n182:             for i in range(len(FX[s]['qs'])):\n183:                 d[(s, i)] = rr[str(i)].get('picks') or []\n184:     if len(d) == 835:\n185:         CODEX[m] = d\n186: \n187: \n188: def split_c(picks):\n189:     out = {}\n190:     for lab, ss in (('mix8~11(Codex \ucd9c\uc81c)', ['mix8', 'mix9', 'mix10', 'mix11']), ('mix12(Claude \ucd9c\uc81c)', ['mix12'])):\n191:         ks = [k for k in KEYS if k[0] in ss]\n192:         out[lab] = (sum(1 for k in ks if frozenset(picks.get(k) or []) == GSET[k]), len(ks))\n193:     return out\n194: \n195: \n196: print(f'{\"\ud480\uc774\ud55c \ucabd\":<44}{\"C \uc804\uccb4(835)\":>14}{\"\uc694\uccad \ub458 C\":>11}{\"mix8~11 C\":>13}{\"mix12 C\":>11}  \uacf5\uc815\uc131')\n197: for m, d in CODEX.items():\n198:     c_all, c_non, c_comp, a, b = score_multi(d)\n199:     sp = split_c(d)\n200:     x, y = sp['mix8~11(Codex \ucd9c\uc81c)'], sp['mix12(Claude \ucd9c\uc81c)']\n201:     print(f'Codex {m:<38}{c_all:>8}/835 {100 * c_all / 835:4.1f}%{c_comp:>6}/66{x[0]:>8}/{x[1]} {y[0]:>6}/{y[1]}  mix12 \ub9cc \uc0c1\ub300\uc801\uc73c\ub85c \uacf5\uc815(mix8~11 \uc740 Codex \ucd9c\uc81c \ud3b8\ud5a5)')\n202: for label, d in MULTI.items():\n203:     if 'Gemma' in label:\n204:         continue\n205:     c_all, c_non, c_comp, a, b = score_multi(d)\n206:     sp = split_c(d)\n207:     x, y = sp['mix8~11(Codex \ucd9c\uc81c)'], sp['mix12(Claude \ucd9c\uc81c)']\n208:     print(f'{label[:44]:<44}{c_all:>8}/835 {100 * c_all / 835:4.1f}%{c_comp:>6}/66{x[0]:>8}/{x[1]} {y[0]:>6}/{y[1]}  \u2605\uc815\ub2f5 \ud0a4\u00b7mix12 \ub97c Claude \uac00 \ub9cc\ub4e6 \u2014 mix8~11 \uce78\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \uacf5\uc815')", "program/scripts/plan_qa_bench/server/qlora_train.py": "1: # \uc11c\ubc84\uc5d0\uc11c: \uc99d\ub958 \ud30c\uc77c\ub7ff \u2014 \ud559\uc0dd \ubaa8\ub378(Gemma 4 E4B)\uc744 4\ube44\ud2b8(NF4)\ub85c \uc62c\ub9ac\uace0 LoRA \ub9cc \ud559\uc2b5\ud55c\ub2e4(QLoRA). \uc815\ub2f5 \ud1a0\ud070\uc5d0\ub9cc \uc190\uc2e4\uc744 \uc900\ub2e4.\n2: #  \uc785\ub825: train.jsonl(prompt \u00b7 completion) \u2014 \ub85c\uceec distill_assemble.py \uac00 \ub9cc\ub4e0 \uac83. \ubaa8\ub378\uc740 HF \ud615\uc2dd \ud3f4\ub354.\n3: #  \uba54\ubaa8\ub9ac: \uc5b4\ud718\uac00 26\ub9cc\uc774\ub77c \uc804 \uc704\uce58\uc5d0 \ub85c\uc9d3\uc744 \ub9cc\ub4e4\uba74 2GB \uac00 \ub118\ub294\ub2e4 \u2192 \uc815\ub2f5\uc774 \ub05d\uc5d0 \uc788\uc73c\ubbc0\ub85c logits_to_keep \uc73c\ub85c \ub05d \uba87 \ud1a0\ud070\ub9cc \ub9cc\ub4e0\ub2e4.\n4: # \uc0ac\uc6a9: python3 qlora_train.py <\ubaa8\ub378\ud3f4\ub354> <train.jsonl> <\uc5b4\ub311\ud130 \ucd9c\ub825 \ud3f4\ub354> [--epochs 2] [--lr 2e-4] [--rank 16] [--accum 8] [--limit N] [--maxlen 3072] [--seed 20261005]\n5: import json, math, os, random, sys, time\n6: import torch\n7: from peft import LoraConfig, get_peft_model\n8: from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n9: \n10: MODEL, TRAIN, OUT = sys.argv[1:4]\n11: a = sys.argv[4:]\n12: \n13: \n14: def opt(name, default, cast=float):\n15:     return cast(a[a.index(name) + 1]) if name in a else default\n16: \n17: \n18: EPOCHS, LR, RANK, ACCUM, LIMIT, MAXLEN, SEED = opt('--epochs', 2, int), opt('--lr', 2e-4), opt('--rank', 16, int), opt('--accum', 8, int), opt('--limit', 0, int), opt('--maxlen', 3072, int), opt('--seed', 20261005, int)\n19: random.seed(SEED)\n20: torch.manual_seed(SEED)\n21: tok = AutoTokenizer.from_pretrained(MODEL)\n22: rows = [json.loads(l) for l in open(TRAIN, encoding='utf-8')]\n23: if LIMIT:\n24:     rows = rows[:LIMIT]\n25: \n26: \n27: def encode(r):\n28:     p = tok.apply_chat_template([{'role': 'user', 'content': r['prompt']}], add_generation_prompt=True, tokenize=False)\n29:     pi = tok(p, add_special_tokens=False)['input_ids']\n30:     ci = tok(r['completion'] + '<turn|>', add_special_tokens=False)['input_ids']\n31:     return pi, ci\n32: \n33: \n34: data = []\n35: for r in rows:\n36:     pi, ci = encode(r)\n37:     if len(pi) + len(ci) <= MAXLEN:\n38:         data.append((pi, ci))\n39: print(f'\ud559\uc2b5 \ubb38\uc81c {len(data)}/{len(rows)} \u00b7 \ud3c9\uade0 \uae38\uc774 {sum(len(p) + len(c) for p, c in data) / len(data):.0f} \ud1a0\ud070 \u00b7 \uc815\ub2f5 \ud1a0\ud070 \ud3c9\uade0 {sum(len(c) for p, c in data) / len(data):.1f}', flush=True)\n40: bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type='nf4', bnb_4bit_use_double_quant=True, bnb_4bit_compute_dtype=torch.bfloat16)\n41: model = AutoModelForCausalLM.from_pretrained(MODEL, quantization_config=bnb, dtype=torch.bfloat16, device_map={'': 0})\n42: print('\ubaa8\ub378 \uc62c\ub9bc \u00b7 GPU \uba54\ubaa8\ub9ac', f'{torch.cuda.memory_allocated() / 2**30:.1f}GB', flush=True)\n43: # prepare_model_for_kbit_training \uc740 \uc591\uc790\ud654 \uc548 \ub41c \ub9e4\uac1c\ubcc0\uc218\ub97c fp32 \ub85c \uc62c\ub9b0\ub2e4 \u2014 26\ub9cc\u00d7(42\uce35\u00d7256) \uc9dc\ub9ac \uce35\ubcc4 \uc784\ubca0\ub529 \ud45c(\uc57d 5.6GB)\uac00 11GB \uac00 \ub418\ubbc0\ub85c \uc4f0\uc9c0 \uc54a\ub294\ub2e4.\n44: model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant': False})\n45: model.enable_input_require_grads()\n46: cfg = LoraConfig(r=RANK, lora_alpha=2 * RANK, lora_dropout=0.05, bias='none', task_type='CAUSAL_LM',\n47:                  target_modules=r'.*language_model.*\\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)')\n48: model = get_peft_model(model, cfg)\n49: model.print_trainable_parameters()\n50: params = [p for p in model.parameters() if p.requires_grad]\n51: opt_ = torch.optim.AdamW(params, lr=LR, weight_decay=0.0, betas=(0.9, 0.999))\n52: steps = math.ceil(len(data) * EPOCHS / ACCUM)\n53: warm = max(1, int(0.05 * steps))\n54: sched = torch.optim.lr_scheduler.LambdaLR(opt_, lambda s: (s + 1) / warm if s < warm else 0.5 * (1 + math.cos(math.pi * (s - warm) / max(1, steps - warm))) * 0.9 + 0.1)\n55: model.train()\n56: t0, done, run_loss, nlog = time.time(), 0, 0.0, 0\n57: for ep in range(EPOCHS):\n58:     order = list(range(len(data)))\n59:     random.shuffle(order)\n60:     for k, i in enumerate(order):\n61:         pi, ci = data[i]\n62:         ids = torch.tensor([pi + ci], device='cuda')\n63:         keep = len(ci) + 1                       # \uc815\ub2f5 \uccab \ud1a0\ud070\uc744 \ub9de\ud788\ub294 \uc704\uce58(\ud504\ub86c\ud504\ud2b8 \ub9c8\uc9c0\ub9c9)\ubd80\ud130 \ub05d\uae4c\uc9c0\n64:         out = model(input_ids=ids, logits_to_keep=keep)\n65:         logits = out.logits[0, :-1].float()      # \ub9c8\uc9c0\ub9c9 \uc704\uce58 \ub85c\uc9d3\uc740 \ub2e4\uc74c \ud1a0\ud070 \uc608\uce21\uc774\ub77c \uc4f0\uc9c0 \uc54a\ub294\ub2e4\n66:         loss = torch.nn.functional.cross_entropy(logits, torch.tensor(ci, device='cuda'))\n67:         (loss / ACCUM).backward()\n68:         run_loss += loss.item()\n69:         nlog += 1\n70:         if (k + 1) % ACCUM == 0 or k == len(order) - 1:\n71:             torch.nn.utils.clip_grad_norm_(params, 1.0)\n72:             opt_.step()\n73:             sched.step()\n74:             opt_.zero_grad(set_to_none=True)\n75:             done += 1\n76:             if done % 10 == 0 or done == steps:\n77:                 el = time.time() - t0\n78:                 print(f'ep {ep + 1} step {done}/{steps} loss {run_loss / nlog:.4f} lr {sched.get_last_lr()[0]:.2e} {el / 60:.1f}\ubd84 \u00b7 \ub0a8\uc740 \uc57d {el / done * (steps - done) / 60:.0f}\ubd84 \u00b7 \ucd5c\ub300 GPU {torch.cuda.max_memory_allocated() / 2**30:.1f}GB', flush=True)\n79:                 run_loss, nlog = 0.0, 0\n80: os.makedirs(OUT, exist_ok=True)\n81: model.save_pretrained(OUT)\n82: print('\uc800\uc7a5', OUT, f'\ucd1d {(time.time() - t0) / 60:.1f}\ubd84', flush=True)", "program/scripts/plan_qa_bench/server/jev_cls_run.py": "1: # \uc11c\ubc84\uc5d0\uc11c: Jev \uacc4\uc5f4 \uc18c\ud615 \uacb0\uc815 \ubaa8\ub378(\ud559\uc2b5 \uc5c6\uc774, \uc601\uc810)\uc774 \uc5ec\ud589 \uace0\uac1d \uba54\uc2dc\uc9c0 \ub124 \uac00\uc9c0 \ub77c\ubca8(\uc758\ub3c4 \u00b7 \uac10\uc815 \u00b7 \uae34\uae09\ub3c4 \u00b7 \ub300\uc0c1 \uc885\ub958)\uc744 \uc5bc\ub9c8\ub098 \ub9de\ud788\ub294\uc9c0 \uc7b0\ub2e4.\n2: #  \ud55c \uba54\uc2dc\uc9c0\uc5d0 \uc9c8\ubb38 4\uac1c\ub97c \ud55c \ubc88\uc5d0 \ubcf4\ub0b8\ub2e4(Jev \uacc4\uc5f4\uc758 \u300c\ud55c \uc0c1\ud0dc \u00b7 \uc5ec\ub7ec \uc9c8\ubb38\u300d \ubc29\uc2dd \u2014 \uc120\ud0dd\uc9c0 \uc124\uba85\uc744 criteria \ub85c \uc900\ub2e4). \ubaa8\ub378\uc5d0\uac8c \uc6b0\ub9ac \ud559\uc2b5 \uc790\ub8cc\ub294 \uc8fc\uc9c0 \uc54a\ub294\ub2e4.\n3: #  \ucd9c\ub825\uc740 llm_cls_*.json \uacfc \uac19\uc740 \ubaa8\uc591({\uc2dc\ud5d8\ud30c\uc77c: {preds:[{id,intent,sentiment,severity,case_type}], lat_median_s, n}}) + \ud655\ub960(probs)\uc774\ub77c cls_report.py \uac00 \uadf8\ub300\ub85c \uc77d\ub294\ub2e4.\n4: # \uc0ac\uc6a9: python3 jev_cls_run.py <\ubc31\uc5d4\ub4dc> <\ud0dc\uadf8> <\uc2dc\ud5d8\ud30c\uc77c,...> [--lang ko|en] [--model <\ubaa8\ub378id>] [--url <systemone\uc8fc\uc18c>] [--device cpu|cuda]\n5: #   \ubc31\uc5d4\ub4dc: laya(laya.load) \u00b7 opendecider(opendecider.load) \u00b7 systemone(llama.cpp /v1/systemone \u2014 Winnow-E4B \ub4f1)\n6: import json, os, sys, time, urllib.request\n7: if os.environ.get('JEV_THREADS'):   # \uc11c\ubc84 \ucf54\uc5b4\uac00 \ub9ce\uace0 \ub2e4\ub978 \uc791\uc5c5\uc774 \uacb9\uce58\uba74 \uc2a4\ub808\ub4dc \uacfc\ub2e4 \uacbd\uc7c1\uc73c\ub85c \ud06c\uac8c \ub290\ub824\uc9c4\ub2e4 \u2014 \uac1c\uc218\ub97c \uc81c\ud55c\ud55c\ub2e4\n8:     import torch\n9:     torch.set_num_threads(int(os.environ['JEV_THREADS']))\n10: \n11: BACK, TAG, TESTS = sys.argv[1], sys.argv[2], sys.argv[3].split(',')\n12: a = sys.argv[4:]\n13: opt = lambda k, d=None: a[a.index(k) + 1] if k in a else d\n14: LANG, MODEL, URL, DEVICE = opt('--lang', 'ko'), opt('--model'), opt('--url'), opt('--device', 'cpu')\n15: \n16: DEF = {\n17:     'ko': {\n18:         'intent': ('\uace0\uac1d \uba54\uc2dc\uc9c0\uc758 \uc694\uccad \uc885\ub958\ub294 \ubb34\uc5c7\uc778\uac00?', {\n19:             'itinerary_submit': '\uc5ec\ud589 \uc77c\uc815\uc744 \ubcf4\ub0b4\uac70\ub098 \ub4f1\ub85d\u00b7\uac80\uc99d\ud574 \ub2ec\ub77c\ub294 \ub9d0',\n20:             'incident_report': '\uc774\ubbf8 \uc77c\uc5b4\ub09c \ubb38\uc81c(\ub2a6\uc74c\u00b7\ud734\ubb34\u00b7\ub9e4\uc9c4\u00b7\ub0a0\uc528\u00b7\uae38 \ub9c9\ud798\u00b7\ubd84\uc2e4\u00b7\uc0ac\uace0)\ub97c \uc54c\ub9ac\ub294 \ub9d0',\n21:             'confirm_request': '\uc601\uc5c5\uc2dc\uac04\u00b7\uc774\ub3d9 \uc2dc\uac04\u00b7\uc608\uc57d \uc0c1\ud0dc \ub4f1\uc744 \ubb3b\uac70\ub098 \ud655\uc778\ud574 \ub2ec\ub77c\ub294 \ub9d0',\n22:             'adjust_reject': '\uc77c\uc815\uc744 \ubc14\uafd4 \ub2ec\ub77c\u00b7\ucde8\uc18c\ud574 \ub2ec\ub77c\u00b7\uc6d0\ub798\ub300\ub85c \ub418\ub3cc\ub824 \ub2ec\ub77c, \ub610\ub294 \uc81c\uc548\uc744 \uac70\uc808\ud558\ub294 \ub9d0',\n23:             'other': '\uc778\uc0ac\u00b7\uc7a1\ub2f4\u00b7\uac10\uc0ac\u00b7\uc758\ubbf8 \uc5c6\ub294 \ub9d0\u00b7\uc11c\ube44\uc2a4 \ubc94\uc704 \ubc16 \uc694\uccad'}),\n24:         'case_type': ('\uace0\uac1d \uba54\uc2dc\uc9c0\uac00 \ub9d0\ud558\ub294 \ub300\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?', {\n25:             'activity': '\uad00\uad11\u00b7\uccb4\ud5d8\u00b7\uacf5\uc5f0\u00b7\uc1fc\ud551 \ub4f1 \uc5ec\ud589\uc9c0\uc5d0\uc11c \ud558\ub294 \ud65c\ub3d9',\n26:             'dining': '\uc2dd\ub2f9\u00b7\uce74\ud398',\n27:             'mobility': '\uc9c0\ud558\ucca0\u00b7\ubc84\uc2a4\u00b7\ud0dd\uc2dc\u00b7\ub3c4\ubcf4\u00b7\uacf5\ud56d \uc774\ub3d9',\n28:             'booking': '\uc608\uc57d\u00b7\uacb0\uc81c\u00b7\ucde8\uc18c\u00b7\ubcc0\uacbd \uac19\uc740 \uc608\uc57d \uae30\ub85d',\n29:             'lodging': '\uc219\uc18c',\n30:             'flight': '\ud56d\uacf5\ud3b8',\n31:             'other': '\ub300\uc0c1\uc774 \uc5c6\uac70\ub098 \uc804\uccb4 \uc77c\uc815\u00b7\uc7a1\ub2f4'}),\n32:         'sentiment': ('\uace0\uac1d\uc758 \uac10\uc815\uc740 \ubb34\uc5c7\uc778\uac00?', {\n33:             'positive': '\ub9cc\uc871\u00b7\uae30\uc068\u00b7\uac10\uc0ac',\n34:             'neutral': '\uac10\uc815 \ud45c\ud604 \uc5c6\uc774 \uc0ac\uc2e4\uc744 \ub9d0\ud558\uac70\ub098 \uc694\uccad',\n35:             'negative': '\ubd88\ub9cc\u00b7\ubd88\uc548\u00b7\uc9dc\uc99d\u00b7\uac71\uc815\u00b7\ub2f9\ud669'}),\n36:         'severity': ('\uc774 \uba54\uc2dc\uc9c0\ub294 \uc5bc\ub9c8\ub098 \uae09\ud55c\uac00?', {\n37:             'low': '\uae09\ud558\uc9c0 \uc54a\ub2e4. \uc77c\ubc18 \ubb38\uc758\u00b7\uc5ec\uc720 \uc788\ub294 \ubcc0\uacbd\u00b7\uc7a1\ub2f4',\n38:             'medium': '\uace7 \ucc98\ub9ac\ud574\uc57c \ud558\uc9c0\ub9cc \ub2f9\uc7a5 \uc77c\uc815\uc774 \uae68\uc9c0\uc9c0\ub294 \uc54a\ub294\ub2e4(\uc624\ub298 \uc548\u00b7\ub0b4\uc77c \uc77c\uc815 \ud655\uc778/\ubcc0\uacbd, \uc57d\uac04\uc758 \uc9c0\uc5f0)',\n39:             'high': '\uc9c0\uae08~1~2\uc2dc\uac04 \uc548\uc758 \uc77c\uc815\uc5d0 \uc9c0\uc7a5\uc774 \uc0dd\uae30\uace0 \uc788\uac70\ub098 \uace7 \uc0dd\uae34\ub2e4(\uc774\ubbf8 \ub2a6\uc74c\u00b7\ubb38 \ub2eb\uc74c\u00b7\uae38 \ub9c9\ud798\u00b7\ub9e4\uc9c4 \uc9c1\uc804)',\n40:             'critical': '\uc548\uc804\u00b7\uac74\uac15\u00b7\uadc0\uad6d\ud3b8 \ub193\uce68\u00b7\uc5ec\uad8c \ubd84\uc2e4\u00b7\uc0ac\uace0\ucc98\ub7fc \uc989\uc2dc \uc870\uce58\uac00 \ud544\uc694\ud558\ub2e4'}),\n41:     },\n42:     'en': {\n43:         'intent': ('What kind of request is this travel customer message?', {\n44:             'itinerary_submit': 'sending or registering a trip itinerary and asking to register/validate it',\n45:             'incident_report': 'reporting a problem that already happened (running late, closed, sold out, weather, blocked road, lost item, accident)',\n46:             'confirm_request': 'asking or requesting confirmation (opening hours, travel time, booking status)',\n47:             'adjust_reject': 'asking to change, cancel or revert the plan, or rejecting a proposal',\n48:             'other': 'greeting, small talk, thanks, meaningless input, or a request outside the service'}),\n49:         'case_type': ('What is the message about?', {\n50:             'activity': 'sightseeing, experiences, shows, shopping \u2014 things to do at the destination',\n51:             'dining': 'restaurants and cafes',\n52:             'mobility': 'subway, bus, taxi, walking, airport transfer',\n53:             'booking': 'reservation, payment, cancellation or change records',\n54:             'lodging': 'accommodation',\n55:             'flight': 'flights',\n56:             'other': 'no particular target, the whole itinerary, or small talk'}),\n57:         'sentiment': ('What is the customer feeling?', {\n58:             'positive': 'satisfaction, joy, gratitude',\n59:             'neutral': 'no emotion, just facts or a request',\n60:             'negative': 'complaint, anxiety, irritation, worry, panic'}),\n61:         'severity': ('How urgent is this message?', {\n62:             'low': 'not urgent: general question, relaxed change, small talk',\n63:             'medium': 'needs handling soon but the schedule is not breaking right now (today/tomorrow checks or changes, slight delay)',\n64:             'high': 'the schedule within the next 1-2 hours is being or about to be disrupted (already late, closed, blocked road, almost sold out)',\n65:             'critical': 'safety, health, missing the return flight, lost passport, accident \u2014 immediate action needed'}),\n66:     },\n67: }[LANG]\n68: HEADS = ['intent', 'sentiment', 'severity', 'case_type']\n69: \n70: \n71: def questions():\n72:     return {h: {'type': 'choice', 'instructions': DEF[h][0], 'criteria': DEF[h][1]} for h in HEADS}\n73: \n74: \n75: if BACK == 'laya':\n76:     import laya\n77:     agent = laya.load(MODEL or 'convaiinnovations/laya-multilingual', device=DEVICE)\n78: \n79:     def ask(msg):\n80:         r = agent.predict(msg, questions())['answers']\n81:         return {h: (r[h].get('probabilities') or {}) for h in HEADS}\n82: elif BACK == 'opendecider':\n83:     from opendecider import Choice, load\n84:     model = load(MODEL or 'manjunathshiva/opendecider-small', device=DEVICE if DEVICE != 'cpu' else None, dtype='bfloat16' if (DEVICE != 'cpu' and 'nano' in (MODEL or '')) else None)\n85: \n86:     def ask(msg):\n87:         qs = {h: Choice(DEF[h][0], dict(DEF[h][1])) for h in HEADS}\n88:         r = model.system_one({'message': msg}, qs)['answers']\n89:         return {h: (r[h].get('probabilities') or {}) for h in HEADS}\n90: elif BACK == 'systemone':\n91:     def ask(msg):\n92:         body = {'state': {'customer_message': msg}, 'questions': questions()}\n93:         if MODEL:\n94:             body['model'] = MODEL\n95:         req = urllib.request.Request(URL, data=json.dumps(body).encode(), headers={'Content-Type': 'application/json'})\n96:         r = json.load(urllib.request.urlopen(req, timeout=600))\n97:         r = r.get('answers') or r\n98:         return {h: (r[h].get('probabilities') or {}) for h in HEADS}\n99: else:\n100:     raise SystemExit('\ubc31\uc5d4\ub4dc\ub294 laya \u00b7 opendecider \u00b7 systemone \uc911 \ud558\ub098')\n101: \n102: try:\n103:     ask('\uc548\ub155\ud558\uc138\uc694')   # \uc608\uc5f4\n104: except Exception as e:  # noqa: BLE001\n105:     print('\uc608\uc5f4 \uc2e4\ud328(\uccab \ud638\ucd9c \uc624\ub958):', repr(e)[:300], flush=True)\n106: \n107: out, errs = {}, 0\n108: for t in TESTS:\n109:     rows = [json.loads(l) for l in open(t, encoding='utf-8')]\n110:     res, lat = [], []\n111:     for r in rows:\n112:         t0 = time.perf_counter()\n113:         try:\n114:             pr = ask(r['message'])\n115:         except Exception as e:  # noqa: BLE001\n116:             pr, errs = {h: {} for h in HEADS}, errs + 1\n117:             if errs <= 3:\n118:                 print('\uc624\ub958:', repr(e)[:200], flush=True)\n119:         lat.append(time.perf_counter() - t0)\n120:         if len(lat) % 25 == 0:\n121:             print(TAG, t, f'{len(lat)}/{len(rows)}', '\uac74\ub2f9 \uc911\uc559', round(sorted(lat)[len(lat) // 2], 2), '\ucd08', flush=True)\n122:         res.append({'id': r['id'], **{h: (max(pr[h], key=pr[h].get) if pr[h] else None) for h in HEADS}, 'probs': pr})\n123:     out[t] = {'preds': res, 'lat_median_s': sorted(lat)[len(lat) // 2], 'n': len(rows), 'errors': errs}\n124:     print(TAG, t, len(rows), '\uc911\uc559 \uc9c0\uc5f0', round(out[t]['lat_median_s'], 3), '\ucd08 \u00b7 \uc624\ub958', errs, flush=True)\n125: json.dump(out, open(f'jev_cls_{TAG}.json', 'w', encoding='utf-8'), ensure_ascii=False)", "program/scripts/plan_qa_bench/eval_router.py": "1: # ML \ubd84\uae30(V2)\uc640 \uadf8\ub798\ud504 \ubb38\uc9c0\uae30(V3)\uc758 \uc2dc\ud5d8 \u2014 \uc5f0\uad6c \ubb38\uc11c \u00a740 \uc0ac\uc804 \ub4f1\ub85d.\n2: #  \uae30\uc900(B0/V1) = \uc55e\ub2e8 \uc810\uc218\uac00 \ubb38\ud131\uc744 \ub118\uc73c\uba74 \ud655\uc815 \u00b7 \ub0ae\uc73c\uba74 \uc5c6\uc74c \u00b7 \uc0ac\uc774\ub294 LLM(\ubb38\ud131\uc740 heavy \uac1c\ubc1c\uc6a9 44 \ub85c \uc120\ud0dd).\n3: #  V2 = \uac19\uc740 \uc790\ub9ac(\uaddc\uce59\u00b7\uc55e \ub300\ud654\uac00 \ubabb \uc815\ud55c \ubb38\uc81c)\uc5d0\uc11c \ub2e4\ud56d \ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0\uac00 \u300c\uc55e\ub2e8 1\uc704\uac00 \ub9de\uc74c(A) \u00b7 \ud2c0\ub9bc(B) \u00b7 \uc815\ub2f5 \uc5c6\uc74c(N)\u300d\uc758 \ud655\ub960\uc744 \ub0b4\uace0, \uc138 \ud589\ub3d9(\ud655\uc815\u00b7\uc5c6\uc74c\u00b7LLM)\uc758 \uae30\ub300 \ubcf4\uc0c1\uc774 \uac00\uc7a5 \ud070 \uac83\uc744 \uace0\ub978\ub2e4.\n4: #    \ubcf4\uc0c1: \ub9de\uc74c +1 \u00b7 \ud2c0\ub9b0 \ub2f5 \u22122 \u00b7 \uc5c6\uc74c\uc73c\ub85c \ub2eb\uc74c = \uc815\ub2f5 \uc5c6\uc744 \ub54c +1, \uc788\uc744 \ub54c 0 \u00b7 LLM = \ud559\uc2b5 \uc138\ud2b8\uc5d0\uc11c \uc7b0 \ud3c9\uade0 \ubcf4\uc0c1 \u2212 0.05(\ud638\ucd9c \ube44\uc6a9).  \ubd84\uae30 \ubb38\ud131\uc774 \ub530\ub85c \uc5c6\ub2e4(\ube44\uc6a9 0.05 \ub294 \uc9c0\uae08\uae4c\uc9c0\uc758 \ubaa9\uc801\uc2dd \uadf8\ub300\ub85c).\n5: #  V3 = \ubb38\ud131 \ubc29\uc2dd\uc5d0\uc11c \uc55e\ub2e8 1\uc704\ub85c \ud655\uc815\ud558\uae30 \uc804\uc5d0, \uac19\uc740 \uc7a5\uc18c \uc774\ub984\uc758 \ub2e4\ub978 \ud56d\ubaa9\uc774 1\uc704 \uc810\uc218\uc758 0.85 \ubc30 \uc774\uc0c1\uc774\uba74 LLM \uc73c\ub85c \ubcf4\ub0b8\ub2e4(\uac19\uc740 \uc7a5\uc18c \uac04\uc120).\n6: #  \ud3c9\uac00: \uc138\ud2b8 \ud558\ub098\ub97c \ube7c\uace0 \ud559\uc2b5\ud574 \uadf8 \uc138\ud2b8\uc5d0\uc11c \uc2dc\ud5d8(heavy \ub294 \ud310\uc815 88). mix8 \uc2dc\ud5d8\uc740 \ubaa8\ub4e0 \ub77c\ubca8 \uc138\ud2b8\ub85c \ud559\uc2b5\ud574 mix8 \ud558\ub098\ub9cc \uc4f4\ub2e4(--final mix8).\n7: # \uc0ac\uc6a9: python eval_router.py [TAG=e16d] [--final mix8] [--md \ucd9c\ub825\ud30c\uc77c]\n8: import contextlib, io, json, math, os, random, sys\n9: import numpy as np\n10: from sklearn.linear_model import LogisticRegression\n11: from sklearn.preprocessing import StandardScaler\n12: \n13: HERE = os.path.dirname(os.path.abspath(__file__))\n14: tag = next((a for a in sys.argv[1:] if not a.startswith('--') and a != sys.argv[sys.argv.index('--final') + 1 if '--final' in sys.argv else -1] and a != (sys.argv[sys.argv.index('--md') + 1] if '--md' in sys.argv else '')), 'e16d')\n15: final = sys.argv[sys.argv.index('--final') + 1] if '--final' in sys.argv else None\n16: argv0 = sys.argv\n17: sys.argv = ['x']\n18: src = open(os.path.join(HERE, 'eval_front_v3.py'), encoding='utf-8').read()\n19: head = src[:src.index('res = {}')]\n20: ns0 = {'__name__': 'ev', '__file__': os.path.join(HERE, 'eval_front_v3.py')}\n21: with contextlib.redirect_stdout(io.StringIO()):\n22:     exec(compile(head, 'h', 'exec'), ns0)\n23: ns = ns0['load'](tag)\n24: sys.argv = argv0\n25: SETS, G, run, pipe, grid, dev, IDX, top, S = (ns[k] for k in ('SETS', 'G', 'run', 'pipe', 'grid', 'dev', 'IDX', 'top', 'S'))\n26: M = 'gemma4:e4b-it-qat'\n27: R = lambda *a: os.path.join(HERE, 'results', *a)\n28: J = lambda f: json.load(open(f, encoding='utf-8'))\n29: if final:\n30:     SETS[final] = J(os.path.join(HERE, 'fixtures', f'{final}.json'))['sets'][final]\n31:     for p, v in zip(J(os.path.join(HERE, 'fixtures', f'pairs_{final}.json')), J(R(f'ft_{tag}_{final}_scores.json'))[f'ft/emb_{tag}']):\n32:         S[(p['set'], p['qi'])][p['item']] = v\n33:     G[final] = {m: v['picks'] for m, v in J(R(f'llm_{final}_out.json')).items() if isinstance(v, dict) and 'picks' in v and '#' not in m and not m.startswith('_')}\n34: from clauses import analyze\n35: from rule_slots import rule_slots\n36: from slot_lookup import resolve\n37: \n38: LABELED = ['heavy', 'mix4', 'mix5', 'mix6', 'mix7']\n39: EVAL_SETS = [final] if final else LABELED\n40: \n41: \n42: def qidx(w):\n43:     if w == 'heavy' and not final:\n44:         return list(range(len(SETS[w]['qs'])))\n45:     return list(range(len(SETS[w]['qs'])))\n46: \n47: \n48: def stage(w, i, tau_a=0.4):\n49:     \"\"\"\uaddc\uce59\u00b7\uc55e \ub300\ud654\uac00 \uc815\ud558\uba74 ('done', \ub2f5, \ud638\ucd9c\uc5ec\ubd80), \uc55e\ub2e8 \uc790\ub9ac\uba74 ('front', None, None).\"\"\"\n50:     st = SETS[w]\n51:     x = st['qs'][i]\n52:     items = st['items']\n53:     a = analyze(x['q'])\n54:     rs = rule_slots(a['tt'], items)\n55:     if rs['day'] is None:\n56:         rs['day'] = rule_slots(x['q'], items)['day']\n57:     anchor = None\n58:     if rs['rel'] is not None:\n59:         k, p = top(w, 'excl' if a['negation'] else 'tt', i)\n60:         anchor = k if p >= tau_a else None\n61:     slots = {k: rs[k] for k in ('day', 'pos', 'kind', 'meal', 'rel', 'kw', 'nextday')}\n62:     slots['anchor'] = anchor\n63:     r = resolve(items, slots)\n64:     if r[0] == 'item':\n65:         return 'done', r[1], False\n66:     if r[0] == 'none':\n67:         return 'done', None, False\n68:     if x['history']:\n69:         return 'done', G[w][M][i], True\n70:     return 'front', None, None\n71: \n72: \n73: def feats(w, i):\n74:     d = S[(f'{w}_tt', i)]\n75:     v = sorted(d.values(), reverse=True)\n76:     s1, s2 = v[0], v[1] if len(v) > 1 else 0.0\n77:     z = np.array(v) / 0.05\n78:     z = np.exp(z - z.max())\n79:     pz = z / z.sum()\n80:     ent = float(-(pz * np.log(pz + 1e-12)).sum())\n81:     x = SETS[w]['qs'][i]\n82:     a = analyze(x['q'])\n83:     return [s1, s2, s1 - s2, ent, len(x['q']) / 30.0, 1.0 if a['negation'] else 0.0, math.log(len(v))], max(d, key=d.get)\n84: \n85: \n86: def label(w, i, top1):\n87:     g = SETS[w]['qs'][i]['gold']\n88:     if g is None:\n89:         return 2\n90:     return 0 if top1 == g else 1\n91: \n92: \n93: def llm_util(w, i):\n94:     g = SETS[w]['qs'][i]['gold']\n95:     p = G[w][M][i]\n96:     if p == g:\n97:         return 1.0\n98:     return 0.0 if p is None else -2.0\n99: \n100: \n101: # \uc55e\ub2e8 \uc790\ub9ac\uc5d0 \uc624\ub294 \ubb38\uc81c\uc758 \ud2b9\uc9d5\u00b7\ub77c\ubca8\u00b7LLM \ubcf4\uc0c1\n102: DATA = {}\n103: for w in set(LABELED + ([final] if final else [])):\n104:     rows = []\n105:     for i in range(len(SETS[w]['qs'])):\n106:         st = stage(w, i)\n107:         if st[0] != 'front':\n108:             continue\n109:         f, t1 = feats(w, i)\n110:         rows.append((i, f, label(w, i, t1), t1, llm_util(w, i)))\n111:     DATA[w] = rows\n112: \n113: \n114: def fit(train_sets):\n115:     X = np.array([r[1] for w in train_sets for r in DATA[w]])\n116:     y = np.array([r[2] for w in train_sets for r in DATA[w]])\n117:     sc = StandardScaler().fit(X)\n118:     clf = LogisticRegression(max_iter=2000, C=1.0).fit(sc.transform(X), y)\n119:     uL = float(np.mean([r[4] for w in train_sets for r in DATA[w]])) - 0.05\n120:     return sc, clf, uL\n121: \n122: \n123: def router_pred(w, i, model):\n124:     sc, clf, uL = model\n125:     f, t1 = feats(w, i)\n126:     p = np.zeros(3)\n127:     pr = clf.predict_proba(sc.transform([f]))[0]\n128:     for c, q in zip(clf.classes_, pr):\n129:         p[c] = q\n130:     u_acc = p[0] * 1 + (p[1] + p[2]) * (-2)\n131:     u_none = p[2] * 1\n132:     best = max((u_acc, 'acc'), (u_none, 'none'), (uL, 'llm'))[1]\n133:     if best == 'acc':\n134:         return t1, False\n135:     if best == 'none':\n136:         return None, False\n137:     return G[w][M][i], True\n138: \n139: \n140: def same_place_gate(w, i, lo, hi):\n141:     \"\"\"V3: \ubb38\ud131 \ubc29\uc2dd\uc758 \uacb0\uacfc\uc5d0\uc11c, \ud655\uc815(\uc55e\ub2e8 1\uc704)\uc774 \uac19\uc740 \uc7a5\uc18c\uc758 \uacbd\uc7c1 \ud56d\ubaa9\uacfc 0.85 \uc774\ub0b4\uba74 LLM \uc73c\ub85c \ubcf4\ub0b8\ub2e4.\"\"\"\n142:     p, used = run(w, i, lo, hi, M)\n143:     st = stage(w, i)\n144:     if st[0] != 'front' or used:\n145:         return p, used\n146:     d = S[(f'{w}_tt', i)]\n147:     k = max(d, key=d.get)\n148:     if d[k] < hi:\n149:         return p, used\n150:     items = {it['id']: it for it in SETS[w]['items']}\n151:     for j, s in d.items():\n152:         if j != k and items[j]['place'] == items[k]['place'] and s >= 0.85 * d[k]:\n153:             return G[w][M][i], True\n154:     return p, used\n155: \n156: \n157: # \ubb38\ud131(\uac1c\ubc1c\uc6a9 44 \ub85c \uc120\ud0dd)\n158: best = max(grid, key=lambda g: (pipe('heavy', dev, *g, M)[0] - 2 * pipe('heavy', dev, *g, M)[1] - 0.05 * pipe('heavy', dev, *g, M)[2], -g[0]))\n159: out = [f'## ML \ubd84\uae30(V2)\u00b7\uadf8\ub798\ud504 \ubb38\uc9c0\uae30(V3) \u2014 \uc55e\ub2e8 {tag}, \ub118\uae40 E4B QAT, \uae30\uc900 \ubb38\ud131 {best[0]}/{best[1]}(heavy \uac1c\ubc1c\uc6a9 44 \ub85c \uc120\ud0dd)']\n160: tot = {'\uae30\uc900(\ubb38\ud131)': [0, 0, 0], 'V2 ML \ubd84\uae30': [0, 0, 0], 'V3 \uadf8\ub798\ud504 \ubb38\uc9c0\uae30': [0, 0, 0]}\n161: rows_out = []\n162: VEC = {k: [] for k in tot}\n163: for w in EVAL_SETS:\n164:     test_idx = [i for i in range(len(SETS[w]['qs'])) if not (w == 'heavy' and SETS[w]['qs'][i].get('split') != 'held')]\n165:     train_sets = [s for s in LABELED if s != w] if not final else LABELED\n166:     model = fit(train_sets)\n167:     cell = {}\n168:     for name, fn in (('\uae30\uc900(\ubb38\ud131)', lambda i: run(w, i, best[0], best[1], M)), ('V2 ML \ubd84\uae30', None), ('V3 \uadf8\ub798\ud504 \ubb38\uc9c0\uae30', lambda i: same_place_gate(w, i, best[0], best[1]))):\n169:         ok = bad = calls = 0\n170:         for i in test_idx:\n171:             if name == 'V2 ML \ubd84\uae30':\n172:                 st = stage(w, i)\n173:                 p, used = (st[1], st[2]) if st[0] == 'done' else router_pred(w, i, model)\n174:             else:\n175:                 p, used = fn(i)\n176:             g = SETS[w]['qs'][i]['gold']\n177:             ok += p == g\n178:             VEC[name].append(int(p == g))\n179:             bad += p is not None and p != g\n180:             calls += used\n181:         cell[name] = (ok, bad, calls)\n182:         for k, v in zip(range(3), (ok, bad, calls)):\n183:             tot[name][k] += v\n184:     n = len(test_idx)\n185:     rows_out.append((w, n, cell))\n186: out.append('| \uc138\ud2b8 | \ubb38\uc81c | ' + ' | '.join(f'{k} \uc815\ub2f5/\uc5c9\ub6b1/\ud638\ucd9c' for k in tot) + ' |')\n187: out.append('|---|---:|' + '---|' * len(tot))\n188: for w, n, cell in rows_out:\n189:     out.append(f'| {w} | {n} | ' + ' | '.join(f'{cell[k][0]}/{cell[k][1]}/{cell[k][2]}' for k in tot) + ' |')\n190: N = sum(n for _, n, _ in rows_out)\n191: out.append(f'| **\ud569** | {N} | ' + ' | '.join(f'**{tot[k][0]}**/{tot[k][1]}/{tot[k][2]}' for k in tot) + ' |')\n192: from math import comb\n193: \n194: \n195: def mcn(a, b):\n196:     n01 = sum(1 for x, y in zip(a, b) if x == 0 and y == 1)\n197:     n10 = sum(1 for x, y in zip(a, b) if x == 1 and y == 0)\n198:     n = n01 + n10\n199:     p = 1.0 if n == 0 else min(1.0, 2 * sum(comb(n, k) for k in range(0, min(n01, n10) + 1)) / 2 ** n)\n200:     return n01, n10, p\n201: \n202: \n203: for k in ('V2 ML \ubd84\uae30', 'V3 \uadf8\ub798\ud504 \ubb38\uc9c0\uae30'):\n204:     n01, n10, p = mcn(VEC['\uae30\uc900(\ubb38\ud131)'], VEC[k])\n205:     out.append(f'\uc9dd\uc9c0\uc740 \ube44\uad50 {k} vs \uae30\uc900: {k}\ub9cc \ub9de\uc74c {n01} \u00b7 \uae30\uc900\ub9cc \ub9de\uc74c {n10} \u00b7 \uc815\ud655\uac80\uc815 p={p:.3f}')\n206: print('\\n'.join(out))\n207: if '--md' in sys.argv:\n208:     open(sys.argv[sys.argv.index('--md') + 1], 'w', encoding='utf-8').write('\\n'.join(out) + '\\n')"}

