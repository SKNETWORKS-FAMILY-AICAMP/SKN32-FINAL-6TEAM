|\n| L5 \uaddc\uce59 \u2192 Winnow-12B(\uc55e\ub2e8 \uc5c6\uc74c) | 10 : 16 | 13 : 2 | 13 : 2 | 8 : 8 | 15 : 8 |\n| Y2 \uac8c\uc774\ud2b8(e16d \uc784\ubca0\ub529) | 3 : 0 | 2 : 0 | 2 : 1 | 1 : 0 | 3 : 0 |\n| L6 \uaddc\uce59\u2192\uac8c\uc774\ud2b8(e16d \uc784\ubca0\ub529)\u2192E4B QAT | 7 : 3 | 8 : 3 | 7 : 3 | 4 : 3 | 8 : 8 |\n| Ens3 \ub2e4\uc218\uacb0(L6 \u00b7 V9 \u00b7 L5-Decider-12B) | 10 : 1 | 12 : 2 | 9 : 2 | 7 : 6 | 13 : 4 |\n| H1 L6 \u2192 (\uac8c\uc774\ud2b8 \uc74c\uc131\u00b7E4B \uc5c6\uc74c)\uc774\uba74 Decider-12B | 9 : 4 | 9 : 3 | 7 : 4 | 7 : 5 | 11 : 5 |\n| H2 L6 \u2192 E4B \ud655\uc2e0 < \u03c4 \uc774\uba74 Decider-12B | 8 : 3 | 10 : 2 | 9 : 3 | 9 : 2 | 11 : 6 |\n| H4 \uaddc\uce59 \u2192 Decider-12B \ud655\uc2e0 \u2265 \u03c4 \uc774\uba74 \uadf8\ub300\ub85c, \uc544\ub2c8\uba74 L6 | 9 : 6 | 11 : 2 | 11 : 1 | 10 : 3 | 15 : 7 |\n\n### \uc720\ud615\ubcc4 \uc815\ub2f5(\ud569\uce5c \uc2dc\ud5d8 \uc138\ud2b8)\n| \uc720\ud615 | \ubb38\uc81c | B0 | V1 | L1 | L3 | L5 | L6 |\n|---|---:|---:|---:|---:|---:|---:|---:|\n| absent_but_plausible | 78 | 77 | 77 | 77 | 77 | 78 | 77 |\n| change_request | 79 | 77 | 77 | 74 | 76 | 78 | 75 |\n| compound_intent | 66 | 59 | 61 | 51 | 46 | 51 | 51 |\n| confusable_name | 77 | 69 | 69 | 71 | 72 | 74 | 71 |\n| context_pronoun | 71 | 66 | 66 | 66 | 66 | 67 | 66 |\n| duplicate_place | 79 | 62 | 66 | 71 | 76 | 76 | 70 |\n| nameless_description | 75 | 28 | 48 | 59 | 66 | 70 | 56 |\n| negation | 72 | 67 | 66 | 69 | 69 | 69 | 69 |\n| ordinal_relative | 80 | 72 | 73 | 78 | 79 | 78 | 78 |\n| out_of_scope | 80 | 78 | 78 | 76 | 74 | 78 | 78 |\n| typo_slang | 78 | 75 | 74 | 78 | 78 | 76 | 78 |\n\n### \uc7a1\ub2f4 \ubd80\uc791\uc6a9(AI Hub \uc7a1\ub2f4 \uc55e 1500\uac1c \u2014 \ud56d\ubaa9\uc73c\ub85c \ub2f5\ud55c \ube44\uc728, \uc815\ub2f5\uc740 \ud56d\uc0c1 \u300c\uc5c6\uc74c\u300d)\n| \ubc29\uc2dd | LLM \uc73c\ub85c \ub118\uae40 | \ud56d\ubaa9\uc73c\ub85c \ub2f5\ud568 |\n|---|---:|---:|\n| V1 \uc55e\ub2e8 e16d | 1.5% | 2/1500 = 0.13% |\n| Y2 \uac8c\uc774\ud2b8(e16d \uc784\ubca0\ub529) \u03c4_g=0.95 | 1.5% | 2/1500 = 0.13% |\n| L1 \uaddc\uce59\u2192E4B QAT(\uc55e\ub2e8\u00b7\uac8c\uc774\ud2b8 \uc5c6\uc74c) | 100.0% | 56/1500 = 3.73% |\n| L6 \uac8c\uc774\ud2b8(e16d \uc784\ubca0\ub529) \u03c4_g=0.2 | 4.6% | 0/1500 = 0.00% |\n\n### Ens3 \uad6c\uc131\uc6d0 \uc77c\uce58\ub3c4(\uc14b \uc911 \uba87 \uac1c\uac00 \ub9de\ud614\ub098 \u2014 336\ubb38\uc81c)\n| \ub9de\ud78c \uad6c\uc131\uc6d0 \uc218 | 0 | 1 | 2 | 3 |\n|---|---:|---:|---:|---:|\n| \ubb38\uc81c \uc218 | 15 | 33 | 78 | 709 |\n"

