digraph stages {
  graph [rankdir=TB, fontname="Malgun Gothic", nodesep=0.3, ranksep=0.32, dpi=200, pad=0.12];
  node  [shape=box, style="rounded,filled", fontname="Malgun Gothic", fontsize=12, margin="0.16,0.08", width=5.6, fillcolor="#EEF4EF", color="#2D5F48"];
  edge  [color="#5F6B64", fontname="Malgun Gothic", fontsize=10, arrowsize=0.7];

  q   [label="고객 질문 + 그 여행의 일정", fillcolor="#FFFFFF", color="#9FB0A6"];
  s1  [label="1. 규칙(코드)  일정 항목을 코드로 확정\n한 줄 시험에서 835문제 중 125개를 모델 없이 끝냄\n규칙을 빼면 697 → 686 (11개 손해)"];
  s2  [label="2. ML 판별기(학습한 분류 인코더)  범위 밖 질문을 거름\n36개를 범위 밖으로 닫고 36개 모두 맞음 · 건당 35ms", fillcolor="#F6EAD4", color="#C8913A"];
  s3  [label="3. Jev 계열 분류(Winnow-E4B, 학습 없음)  보낼 곳을 고름\n선택 정확도 488/626 = 78.0% · 일정 질문을 잘못 닫음 135/550\n분류 시험: 의도 94.5 · 감정 91.0 · 긴급도 63.5 · 대상 92.1 (%)", fillcolor="#ECEAF8", color="#5B4FB3"];
  s4  [label="4. 전문가: 가르친 E4B(일정 항목 짚기)\n단독으로 쓰면 748/769 = 97.3% (같은 서버 · 같은 GGUF)"];
  a   [label="답 전송", fillcolor="#2D5F48", fontcolor="white"];

  q -> s1; s1 -> s2 [label=" 못 정하면"]; s2 -> s3 [label=" 범위 안이면"]; s3 -> s4 [label=" 짚기로 보냄"]; s4 -> a;
  res [shape=note, fillcolor="#FBE9E7", color="#C0504D", width=2.6, fontsize=11,
       label="한 줄로 이은 시험(10-06, 769문제)\n학습 없는 Winnow-E4B 를 넣은 연결 697\n(사전 등록 판 472, 학습 조건이 달라 불공정)\n빼면 745 = 단독과 같음\n가르친 Winnow-E4B(Jev 계열) 756 · 가르친 E4B 750~760\n(시드 차이 안이라 구분 안 됨)\n여러 분야 전문가 구성은 아직 없음"];
  s3 -> res [style=dashed, color="#C0504D", arrowhead=none];
  {rank=same; s3; res;}
}
