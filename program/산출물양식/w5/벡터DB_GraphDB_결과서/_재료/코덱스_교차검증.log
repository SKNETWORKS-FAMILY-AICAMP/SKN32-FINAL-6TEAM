30: @dataclass(frozen=True)
31: class Document:
32:     manifest: dict[str, Any]
33:     frontmatter: dict[str, Any]
34:     sections: list[Section]
35: 
36: 
37: def _parse_document(path: Path, manifest_entry: dict[str, Any]) -> Document:
38:     text = path.read_text(encoding="utf-8")
39:     match = re.match(r"\A---\s*\n(.*?)\n---\s*\n(.*)\Z", text, re.DOTALL)
40:     if not match:
41:         raise ValueError(f"frontmatter missing: {path}")
42:     frontmatter = yaml.safe_load(match.group(1))
43:     if not isinstance(frontmatter, dict):
44:         raise ValueError(f"invalid frontmatter: {path}")
45:     body = match.group(2).strip()
46:     matches = list(re.finditer(r"(?m)^##\s+(.+?)\s*$", body))
47:     sections: list[Section] = []
48:     for number, heading in enumerate(matches, 1):
49:         start = heading.end()
50:         end = matches[number].start() if number < len(matches) else len(body)
51:         content = body[start:end].strip()
52:         if not content:
53:             raise ValueError(f"empty section {number}: {path}")
54:         sections.append(Section(number, heading.group(1).strip(), content))
55:     expected = manifest_entry.get("section_count")
56:     if expected != len(sections):
57:         raise ValueError(f"section count mismatch for {manifest_entry['document_id']}: {len(sections)} != {expected}")
58:     if frontmatter.get("document_id") != manifest_entry.get("document_id"):
59:         raise ValueError(f"document_id mismatch: {path}")
60:     return Document(manifest_entry, frontmatter, sections)
61: 
62: 
63: def load_corpus(manifest_path: Path | None = None) -> list[Document]:
64:     """manifest 하나를 읽어 문서·섹션으로 쪼갠다.
65: 
66:     ★`[2026-09-22]` 인자를 받게 했다 — 코퍼스가 둘이 됐기 때문이다(쇼핑몰
67:       `knowledge/manifest.json` · 여행 `knowledge/travel/manifest.json`).
68:       **기본값은 예전 그대로**라 이 파일의 다른 호출부는 안 바뀐다.
69: 
70:     ★**청크 경계 규칙은 이 함수 하나가 정한다**(`_parse_document`) — `## ` 로
71:       시작하는 줄 하나가 청크 하나이고, 그 경계는 다음 `## ` 직전까지다.
72:       제목은 본문에 넣지 않고 `metadata_json.section_title` 로 따로 싣는다.
73:       적재 스크립트가 여럿이어도 쪼개는 코드는 여기 하나뿐이어야 한다 —
74:       둘이 되면 같은 문서가 스크립트마다 다른 청크로 들어간다.
75:     """
76:     manifest_path = manifest_path or MANIFEST_PATH
77:     manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
78:     base = manifest_path.parent
79:     tenant_id = manifest["tenant_id"]
80:     return [
81:         _parse_document(base / entry["file"], {**entry, "tenant_id": tenant_id})
82:         for entry in manifest["documents"]
83:     ]
84: 
85: 
86: def _metadata(doc: Document, section: Section) -> dict[str, Any]:
87:     return {
88:         "tenant_id": doc.manifest["tenant_id"],
89:         "scope": doc.frontmatter["scope"],
90:         "document_id": doc.frontmatter["document_id"],
91:         "version": doc.frontmatter["version"],
92:         "pii_class": doc.frontmatter["pii_class"],
93:         "effective_from": str(doc.frontmatter["effective_from"]),
94:         "section_title": section.title,
95:         "chunk_no": section.number,
96:     }
97: 
98: 
99: def dry_run() -> tuple[int, int]:
100:     documents = load_corpus()
101:     chunks = sum(len(document.sections) for document in documents)
102:     print(f"dry-run: documents={len(documents)} chunks={chunks}")
103:     return len(documents), chunks
