28: @lru_cache(maxsize=64)
29: def _embed_query(query: str) -> list[float]:
30:     settings = get_settings()
31:     name, _, dim = _provider()
32:     if name == "ollama":
33:         vector = _embed_with_ollama(query, settings)
34:     else:
