50:     import urllib.request
51: 
52:     if not settings.ollama_base_url:
53:         raise RuntimeError("ACOP_EMBEDDING_PROVIDER=ollama 인데 ACOP_OLLAMA_BASE_URL 이 비어 있다")
54:     request = urllib.request.Request(
55:         settings.ollama_base_url.rstrip("/") + "/api/embed",
56:         data=json.dumps({"model": settings.ollama_embedding_model, "input": query}).encode(),
57:         headers={"content-type": "application/json"})
58:     with urllib.request.urlopen(request, timeout=settings.ollama_timeout_seconds) as response:
59:         payload = json.loads(response.read())
60:     if payload.get("error"):
61:         raise RuntimeError(f"로컬 임베딩 실패: {payload['error']}")
62:     vectors = payload.get("embeddings") or ([payload["embedding"]] if payload.get("embedding") else [])
63:     if not vectors:
64:         raise RuntimeError("로컬 임베딩이 빈 응답을 줬다")
65:     return list(vectors[0])
