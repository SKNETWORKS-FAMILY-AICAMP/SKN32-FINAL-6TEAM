20: def _provider() -> tuple[str, str, int]:
21:     name = (get_settings().embedding_provider or "openai").strip().lower()
22:     if name not in PROVIDERS:
23:         raise RuntimeError(f"ACOP_EMBEDDING_PROVIDER 는 {sorted(PROVIDERS)} 중 하나여야 한다: {name!r}")
24:     column, dim = PROVIDERS[name]
25:     return name, column, dim
