FILE program\산출물양식\w5\벡터DB_GraphDB_결과서\src\measure_local_db.py
1: """벡터DB/GraphDB 결과서용 로컬 개발 DB 읽기 전용 측정 (2026-10-06).
2: 
3: - 모든 질의는 READ ONLY 트랜잭션 안에서 돈다(쓰기 0).
4: - 질문 임베딩 서버(Ollama)가 꺼져 있어, 저장된 청크 벡터를 질의 벡터로 쓴다.
5:   따라서 잰 시간은 'DB 안의 검색 시간'만이고 질문을 벡터로 바꾸는 시간은 빠진다.
6: 결과: ../_재료/로컬DB_측정_2026-10-06.json
7: """
8: from __future__ import annotations
9: 
10: import asyncio
11: import json
12: import statistics
13: import sys
14: import time
15: from pathlib import Path
16: 
17: import psycopg
18: 
19: CS = Path(__file__).resolve().parents[5] / "final_project_cs"
20: sys.path.insert(0, str(CS))
21: from app.infrastructure.graphstore.sql_adapter import SqlGraphAdapter  # noqa: E402
22: 
23: DSN = "postgresql://postgres@127.0.0.1:5433/acop_cs"
24: OUT = Path(__file__).resolve().parents[1] / "_재료" / "로컬DB_측정_2026-10-06.json"
25: SCOPES = ["travel_activity", "travel_weather", "travel_dining", "travel_mobility",
26:           "travel_cancellation", "travel_access"]
27: SEARCH = """SELECT kc.chunk_id, 1 - (kc.embedding_1024 <=> %s::vector) AS score
28:   FROM knowledge_chunks kc JOIN knowledge_documents kd USING(document_id)
29:  WHERE kd.tenant_id = %s AND kd.scope = ANY(%s) AND kc.embedding_1024 IS NOT NULL
30:  ORDER BY kc.embedding_1024 <=> %s::vector LIMIT %s"""
31: 
32: 
33: def pct(xs, p):
34:     xs = sorted(xs)
35:     k = max(0, min(len(xs) - 1, round(p / 100 * (len(xs) - 1))))
36:     return xs[k]
37: 
38: 
39: def main() -> None:
40:     res: dict = {"measured_at": time.strftime("%Y-%m-%d %H:%M"), "dsn_host": "로컬 개발 DB(5433)"}
41:     with psycopg.connect(DSN, autocommit=False) as conn:
42:         conn.execute("SET TRANSACTION READ ONLY")
43:         cur = conn.cursor()
44:         cur.execute("SELECT version()")
45:         res["pg_version"] = cur.fetchone()[0].split(",")[0]
46:         cur.execute("SELECT extversion FROM pg_extension WHERE extname='vector'")
47:         row = cur.fetchone()
48:         res["pgvector"] = row[0] if row else None
49:         cur.execute("""SELECT kd.tenant_id, kd.scope, count(DISTINCT kd.document_id), count(*),
50:                               count(kc.embedding), count(kc.embedding_1024)
51:                          FROM knowledge_chunks kc JOIN knowledge_documents kd USING(document_id)
52:                         GROUP BY 1,2 ORDER BY 1,2""")
53:         res["corpus"] = [dict(zip(["tenant", "scope", "docs", "chunks", "dim1536", "dim1024"], r))
54:                          for r in cur.fetchall()]
55:         cur.execute("""SELECT indexname, indexdef FROM pg_indexes
56:                         WHERE tablename='knowledge_chunks' ORDER BY 1""")
57:         res["indexes"] = [dict(zip(["name", "def"], r)) for r in cur.fetchall()]
58: 
59:         cur.execute("""SELECT kc.chunk_id, kc.embedding_1024::text, kd.tenant_id
60:                          FROM knowledge_chunks kc JOIN knowledge_documents kd USING(document_id)
61:                         WHERE kd.scope = ANY(%s) AND kc.embedding_1024 IS NOT NULL
62:                         ORDER BY kc.chunk_id""", (SCOPES,))
63:         probes = cur.fetchall()
64:         res["probe_count"] = len(probes)
65:         if probes:
66:             tenant = probes[0][2]
67:             # 예열 1회, 이어서 모든 청크를 질의로 한 번씩 3바퀴
68:             cur.execute(SEARCH, (probes[0][1], tenant, SCOPES, probes[0][1], 3))
69:             cur.fetchall()
70:             times, self_hit = [], 0
71:             for rnd in range(3):
72:                 for cid, vec, _ in probes:
73:                     t0 = time.perf_counter()
74:                     cur.execute(SEARCH, (vec, tenant, SCOPES, vec, 3))
75:                     rows = cur.fetchall()
76:                     times.append((time.perf_counter() - t0) * 1000)
77:                     if rnd == 0 and rows and str(rows[0][0]) == str(cid):
78:                         self_hit += 1
79:             res["search_ms"] = {
80:                 "n": len(times), "rounds": 3, "top_k": 3,
81:                 "mean": round(statistics.mean(times), 2), "p50": round(pct(times, 50), 2),
82:                 "p95": round(pct(times, 95), 2), "max": round(max(times), 2),
83:                 "note": "DB 안 검색 시간(파이썬 왕복 포함), 질문 임베딩 시간 제외",
84:             }
85:             res["self_top1"] = {"hit": self_hit, "of": len(probes)}
86:             cur.execute("EXPLAIN (ANALYZE, BUFFERS OFF, TIMING ON) " + SEARCH,
87:                         (probes[0][1], tenant, SCOPES, probes[0][1], 3))
88:             res["explain"] = [r[0] for r in cur.fetchall()]
89:             res["tenant"] = tenant
90: 
91:             # 관계 조회 어댑터를 실제로 실행
92:             g = SqlGraphAdapter(conn, tenant_id=tenant)
93:             cur.execute("""SELECT kd.document_id::text FROM knowledge_documents kd
94:                             WHERE kd.tenant_id=%s AND kd.scope = ANY(%s) ORDER BY 1 LIMIT 1""",
95:                         (tenant, SCOPES))
96:             doc = cur.fetchone()[0]
97:             gt = []
98:             for _ in range(20):
99:                 t0 = time.perf_counter()
100:                 nb = asyncio.run(g.neighbors(doc, ["contains", "in_document"], 2))
101:                 gt.append((time.perf_counter() - t0) * 1000)
102:             res["graph_neighbors"] = {
103:                 "start": "여행 정책 문서 1건", "edge_types": ["contains", "in_document"], "depth": 2,
104:                 "rows": len(nb), "by_depth": {str(d): sum(1 for r in nb if r["depth"] == d) for d in (1, 2)},
105:                 "ms_p50": round(pct(gt, 50), 2), "ms_p95": round(pct(gt, 95), 2), "n": 20,
106:             }
107:             cur.execute("SELECT count(*) FROM customer_cases WHERE tenant_id=%s", (tenant,))
108:             res["customer_cases"] = cur.fetchone()[0]
109:             cur.execute("""SELECT cc.case_id::text FROM customer_cases cc
110:                              JOIN case_events ce ON ce.case_id=cc.case_id
111:                             WHERE cc.tenant_id=%s GROUP BY 1 ORDER BY count(*) DESC LIMIT 1""", (tenant,))
112:             row = cur.fetchone()
113:             if row:
114:                 ct = []
115:                 for _ in range(20):
116:                     t0 = time.perf_counter()
117:                     sg = asyncio.run(g.subgraph(row[0], 2))
118:                     ct.append((time.perf_counter() - t0) * 1000)
119:                 edges = sg.get("edges", sg if isinstance(sg, list) else [])
120:                 kinds: dict = {}
121:                 for e in edges:
122:                     k = e.get("edge_type") if isinstance(e, dict) else None
123:                     kinds[k] = kinds.get(k, 0) + 1
124:                 res["graph_subgraph"] = {
125:                     "start": "사건 1건(이벤트가 가장 많은 것)", "depth": 2,
126:                     "keys": list(sg.keys()) if isinstance(sg, dict) else None,
127:                     "edge_kinds": kinds, "ms_p50": round(pct(ct, 50), 2),
128:                     "ms_p95": round(pct(ct, 95), 2), "n": 20,
129:                 }
130:         conn.rollback()
131:     OUT.write_text(json.dumps(res, ensure_ascii=False, indent=2, default=str), encoding="utf-8")
132:     print(json.dumps(res, ensure_ascii=False, indent=2, default=str)[:6000])
133: 
134: 
135: if __name__ == "__main__":
136:     main()

