37:         vector = OpenAI(api_key=settings.openai_api_key).embeddings.create(
38:             model=settings.embedding_model, input=query
39:         ).data[0].embedding
40:     if len(vector) != dim:
41:         raise ValueError(f"query embedding dimension mismatch: expected {dim}, got {len(vector)}")
42:     # Keep the embedding as a list so pgvector's psycopg adapter serializes it
43:     # as a vector literal ([...]), rather than a PostgreSQL tuple literal (...).
44:     return list(vector)
