6: class SqlGraphAdapter:
7:     """PostgreSQL-backed graph projection using joins and recursive CTEs.
8: 
9:     The adapter is deliberately connection-injected so tests can use a real
10:     PostgreSQL transaction or a small fake cursor without introducing a graph DB.
11:     """
12: 
13:     def __init__(self, connection, *, tenant_id: str) -> None:
14:         if not tenant_id:
15:             raise ValueError("tenant_id is required")
16:         self.connection = connection
17:         self.tenant_id = tenant_id
18: 
19:     def _rows(self, sql: str, params: tuple[Any, ...]) -> list[dict]:
20:         with self.connection.cursor() as cur:
21:             cur.execute(sql, params)
22:             columns = [d.name if hasattr(d, "name") else d[0] for d in cur.description]
23:             return [dict(zip(columns, row)) for row in cur.fetchall()]
24: 
25:     async def neighbors(self, node_id: str, edge_types: list[str], depth: int = 1) -> list[dict]:
26:         if depth < 1 or not edge_types:
27:             return []
28:         return self._rows(
29:             """WITH RECURSIVE edges(src, dst, edge_type, tenant_id) AS (
30:                 SELECT c.customer_id::text, cc.case_id::text, 'owns', c.tenant_id
31:                 FROM customers c JOIN customer_cases cc
32:                   ON cc.customer_id=c.customer_id AND cc.tenant_id=c.tenant_id
33:                 UNION ALL
34:                 SELECT cc.case_id::text, ce.event_id::text, 'has_event', cc.tenant_id
35:                 FROM customer_cases cc JOIN case_events ce
36:                   ON ce.case_id=cc.case_id AND ce.tenant_id=cc.tenant_id
37:                 UNION ALL
38:                 SELECT cc.case_id::text, ar.action_id::text, 'proposed', cc.tenant_id
39:                 FROM customer_cases cc JOIN action_requests ar
40:                   ON ar.case_id=cc.case_id AND ar.tenant_id=cc.tenant_id
41:                 UNION ALL
42:                 SELECT ar.action_id::text, aa.approval_id::text, 'approved', ar.tenant_id
43:                 FROM action_requests ar JOIN action_approvals aa ON aa.action_id=ar.action_id
44:                 UNION ALL
45:                 SELECT kd.document_id::text, kc.chunk_id::text, 'contains', kd.tenant_id
46:                 FROM knowledge_documents kd JOIN knowledge_chunks kc ON kc.document_id=kd.document_id
47:                 UNION ALL
48:                 SELECT kc.chunk_id::text, kd.document_id::text, 'in_document', kd.tenant_id
49:                 FROM knowledge_chunks kc JOIN knowledge_documents kd ON kd.document_id=kc.document_id
50:                 UNION ALL
51:                 -- ★v7 §27-21 이 이름으로 지정한 세 축. issue_code 와 team 은 테이블이 아니라
52:                 --   컬럼이므로 여기서 **노드로 투영**한다. 없던 게 아니라 노출을 안 했던 것이다.
53:                 --   Case → Issue
54:                 SELECT cc.case_id::text, 'issue:'||cc.issue_code, 'has_issue', cc.tenant_id
55:                 FROM customer_cases cc WHERE cc.issue_code IS NOT NULL
56:                 UNION ALL
57:                 --   Issue → Policy  (issue 를 다룬 Case 의 Team scope 로 정책 문서를 잇는다)
58:                 SELECT DISTINCT 'issue:'||cc.issue_code, kd.document_id::text, 'governed_by', kd.tenant_id
59:                 FROM customer_cases cc
60:                 JOIN knowledge_documents kd ON kd.tenant_id=cc.tenant_id
61:                 WHERE cc.issue_code IS NOT NULL AND kd.scope IS NOT NULL
62:                   AND kd.scope = ANY(string_to_array(cc.intent, ','))
63:                 UNION ALL
64:                 --   Issue → Team
65:                 SELECT DISTINCT 'issue:'||cc.issue_code, 'team:'||cc.owner_team_id, 'handled_by', cc.tenant_id
66:                 FROM customer_cases cc
67:                 WHERE cc.issue_code IS NOT NULL AND cc.owner_team_id IS NOT NULL
68:             ), walk(node_id, edge_type, depth) AS (
69:                 SELECT dst, edge_type, 1 FROM edges WHERE src=%s AND tenant_id=%s AND edge_type=ANY(%s)
70:                 UNION ALL SELECT e.dst, e.edge_type, w.depth+1 FROM walk w JOIN edges e ON e.src=w.node_id
71:                 WHERE w.depth < %s AND e.tenant_id=%s AND e.edge_type=ANY(%s)
72:             ) SELECT node_id, edge_type, depth FROM walk ORDER BY depth, node_id""",
73:             (node_id, self.tenant_id, edge_types, depth, self.tenant_id, edge_types),
74:         )
75: 
76:     async def path(self, src: str, dst: str, max_depth: int = 4) -> list[dict]:
77:         if max_depth < 1:
78:             return []
79:         return self._rows(
80:             """WITH RECURSIVE evidence AS (
81:                 SELECT cc.case_id::text AS case_id, cc.tenant_id,
82:                        x.item->>'evidence_id' AS evidence_id,
83:                        x.item->>'source_id' AS source_id
84:                 FROM customer_cases cc
85:                 JOIN case_events ce ON ce.case_id=cc.case_id AND ce.tenant_id=cc.tenant_id
86:                 CROSS JOIN LATERAL jsonb_array_elements(
87:                   COALESCE(ce.payload_json->'evidence',
88:                            ce.payload_json->'state_patch'->'evidence', '[]'::jsonb)
89:                 ) AS x(item)
90:                 WHERE cc.tenant_id=%s
91:             ), graph(src, dst, edge_type, tenant_id) AS (
92:                 SELECT case_id, evidence_id, 'has_evidence', tenant_id FROM evidence
93:                 UNION ALL
94:                 SELECT e.evidence_id, kc.chunk_id::text, 'references_chunk', e.tenant_id
95:                 FROM evidence e JOIN knowledge_chunks kc ON kc.chunk_id::text=e.source_id
96:                 JOIN knowledge_documents kd ON kd.document_id=kc.document_id AND kd.tenant_id=e.tenant_id
97:                 UNION ALL
98:                 SELECT kc.chunk_id::text, kd.document_id::text, 'in_document', kd.tenant_id
99:                 FROM knowledge_chunks kc JOIN knowledge_documents kd ON kd.document_id=kc.document_id
100:                 UNION ALL
101:                 SELECT e.evidence_id, kd.document_id::text, 'references_document', e.tenant_id
102:                 FROM evidence e JOIN knowledge_documents kd
103:                   ON kd.document_id::text=e.source_id AND kd.tenant_id=e.tenant_id
104:             ), walk(node_id, edge_type, depth, trail) AS (
105:                 SELECT %s::text, 'start', 0, ARRAY[%s::text]
106:                 UNION ALL
107:                 SELECT g.dst, g.edge_type, w.depth+1, w.trail||g.dst
108:                 FROM walk w JOIN graph g ON g.src=w.node_id AND g.tenant_id=%s
109:                 WHERE w.depth < %s AND NOT g.dst=ANY(w.trail)
110:             ), target AS (SELECT trail FROM walk WHERE node_id=%s)
111:             SELECT w.node_id, w.edge_type, w.depth
112:             FROM walk w CROSS JOIN target t
113:             WHERE w.node_id=ANY(t.trail) ORDER BY w.depth""",
114:             (self.tenant_id, src, src, self.tenant_id, max_depth, dst),
115:         )
116: 
117:     async def subgraph(self, root_id: str, depth: int = 2) -> dict:
118:         rows = await self.neighbors(root_id, ["owns", "has_event", "proposed", "approved", "contains", "in_document", "has_issue", "governed_by", "handled_by"], depth)
119:         return {"root_id": root_id, "tenant_id": self.tenant_id, "nodes": [root_id] + [r["node_id"] for r in rows], "edges": rows}

