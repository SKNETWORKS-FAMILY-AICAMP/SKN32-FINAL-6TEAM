63: def decode_polyline(s, precision=1e6):
64:     """Google encoded polyline → [(lng, lat)…]. 정밀도 1e-6(road_graph_v1 간선 `g`)."""
65:     out, i, lat, lng, n = [], 0, 0, 0, len(s)
66:     while i < n:
67:         for is_lat in (True, False):
68:             shift = result = 0
69:             while True:
70:                 b = ord(s[i]) - 63
71:                 i += 1
72:                 result |= (b & 0x1F) << shift
73:                 shift += 5
74:                 if b < 0x20:
75:                     break
76:             d = ~(result >> 1) if result & 1 else result >> 1
77:             if is_lat:
78:                 lat += d
79:             else:
80:                 lng += d
81:         out.append((lng / precision, lat / precision))
82:     return out
