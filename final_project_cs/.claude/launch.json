{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acop-cs-ui",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.presentation.api.app:app",
        "--port",
        "8042",
        "--reload"
      ],
      "port": 8042
    },
    {
      "name": "tripilot",
      "url": "http://tripilot.localhost:8042"
    },
    {
      "name": "scenario-console",
      "url": "http://scenario.localhost:8042"
    },
    {
      "name": "labeling-form",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8071",
        "--directory",
        "wiki/records/labeling"
      ],
      "port": 8071
    },
    {
      "name": "acop-cs-ui-stable",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.presentation.api.app:app",
        "--port",
        "8042"
      ],
      "port": 8042
    }
  ]
}
