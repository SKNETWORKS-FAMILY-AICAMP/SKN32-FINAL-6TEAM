{"id": "DAH-01", "group": "move", "why": "저녁 뒤 다음 일정이 남쪽 — 북쪽 가게는 다음 일정에 늦는다", "path": "closed_on_day", "items": [{"seq": 1, "kind": "dining", "title": "저녁", "place": "O", "start": "18:00", "end": "19:00"}, {"seq": 2, "kind": "activity", "title": "야경", "place": "N", "start": "19:17", "end": "20:30"}], "meal": 1, "places": [{"key": "N", "name": "야경 장소", "kind": "activity", "at": [0, -1300]}, {"key": "O", "name": "원래 고깃집", "at": [0, 0], "cuisine": ["한식", "갈비"]}, {"key": "U", "name": "북쪽 고깃집", "at": [0, 250], "cuisine": ["한식", "갈비"]}, {"key": "D", "name": "남쪽 고깃집", "at": [0, -300], "cuisine": ["한식", "갈비"]}], "expect": {"accept": ["D"]}}
