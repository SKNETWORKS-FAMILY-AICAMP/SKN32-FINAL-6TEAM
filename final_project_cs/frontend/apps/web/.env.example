# demo = browser-local demonstration data (no server).
# live = the triPilot server's web API (/v1/web/*): plan reading, confirm screen, trips, chat.
#        The browser holds only a per-user key (X-User-Key), never a server scope key.
NEXT_PUBLIC_DATA_MODE=demo
# live only — the server's base URL (its ACOP_WEB_ALLOWED_ORIGINS must include this web app's origin)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8042

# Choose one map: demo (diagram), osm (free OpenStreetMap tiles), naver, google. Restart dev / rebuild production.
# Live map failure never falls back to demo. Only the selected SDK is loaded.
# osm  — development default. OSM tile policy: attribution always visible, https only, no bulk/offline fetching,
#        no SLA (heavy use may be blocked). Not for a large public service without our own tile server.
# google — ★asks the server first (POST /v1/web/map-load, capped 312/day · 9,688/month); refused or no answer = osm.
NEXT_PUBLIC_MAP_PROVIDER=demo
# Free-map tile address (https, with {z}/{x}/{y}). Empty = the OSM standard tiles.
NEXT_PUBLIC_OSM_TILE_URL=

# Browser credentials only. Restrict them to your site's allowed URLs/APIs.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=
# Google Advanced Markers require a Map ID. DEMO_MAP_ID is for testing only.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# live only — human check (Cloudflare Turnstile) on sending a plan. Empty = off.
# Cloudflare's public test key 1x00000000000000000000AA always passes (for development).
# ★The server must verify the token (siteverify) with the matching secret key, or the check stops nothing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
