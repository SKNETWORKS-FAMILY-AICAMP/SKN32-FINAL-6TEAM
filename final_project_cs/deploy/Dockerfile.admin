# 운영 웹앱과 운영 API는 고객 API와 다른 컨테이너에서 실행한다.
ARG API_IMAGE=tripilot-api:local
FROM node:22-slim AS frontend
WORKDIR /admin
COPY frontend/apps/admin/package.json frontend/apps/admin/package-lock.json ./
RUN npm ci
COPY frontend/apps/admin ./
ENV NEXT_PUBLIC_ADMIN_DATA_MODE=live NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev

FROM ${API_IMAGE}
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend /admin /srv/admin
COPY deploy/admin_runner.py /srv/deploy/admin_runner.py
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 ADMIN_OPS_API_URL=http://127.0.0.1:8070
EXPOSE 3300
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8070/health && curl -fsS http://127.0.0.1:3300/ || exit 1
CMD ["python", "/srv/deploy/admin_runner.py"]
