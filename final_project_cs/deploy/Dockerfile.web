# triPilot 웹앱 이미지 (Next.js).
#
# ★`NEXT_PUBLIC_*` 값은 **빌드할 때 번들에 박힌다** — 주소를 바꾸려면 다시 빌드한다(`docker compose build tripilot-web`).
#   그래서 빌드 인자로 받는다. 같은 출처(역방향 프록시가 `/v1/*` 를 API 로 보낸다)라면 공개 주소를 그대로 넣는다.
# ★빌드 맥락 = 저장소의 `final_project_cs/` (이 파일은 `deploy/Dockerfile.web`).
FROM node:22-slim AS build

WORKDIR /app
COPY frontend/apps/web/package.json frontend/apps/web/package-lock.json ./
RUN npm ci

COPY frontend/apps/web ./

ARG NEXT_PUBLIC_API_BASE=http://127.0.0.1:8043
ARG NEXT_PUBLIC_DATA_MODE=live
ARG NEXT_PUBLIC_MAP_PROVIDER=
ARG NEXT_PUBLIC_OSM_TILE_URL=
ARG NEXT_PUBLIC_GOOGLE_MAP_API_KEY=
ARG NEXT_PUBLIC_GOOGLE_MAP_ID=
ARG NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE \
    NEXT_PUBLIC_DATA_MODE=$NEXT_PUBLIC_DATA_MODE \
    NEXT_PUBLIC_MAP_PROVIDER=$NEXT_PUBLIC_MAP_PROVIDER \
    NEXT_PUBLIC_OSM_TILE_URL=$NEXT_PUBLIC_OSM_TILE_URL \
    NEXT_PUBLIC_GOOGLE_MAP_API_KEY=$NEXT_PUBLIC_GOOGLE_MAP_API_KEY \
    NEXT_PUBLIC_GOOGLE_MAP_ID=$NEXT_PUBLIC_GOOGLE_MAP_ID \
    NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=$NEXT_PUBLIC_NAVER_MAP_CLIENT_ID \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    TZ=Asia/Seoul
WORKDIR /app
COPY --from=build /app ./

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
