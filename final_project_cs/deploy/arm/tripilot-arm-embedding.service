[Unit]
Description=guguroute ARM local travel embeddings
After=network-online.target

[Service]
EnvironmentFile=/etc/tripilot-arm-cd.env
ExecStart=/usr/bin/python3 ${DEPLOY_BASE}/control/embedding.py
Restart=on-failure
RestartSec=30
CPUQuota=40%
MemoryMax=1536M
UMask=0077

[Install]
WantedBy=multi-user.target
