# A-COP — 바깥 데이터 소스 API 키
#
# ★★**이 파일을 `.env.apikeys` 위로 복사하지 마라.** 값이 들어 있는 실제 키
#   파일이 빈 템플릿으로 덮여 사라진다 — 2026-09-10 에 실제로 세 번 났다.
#
#   대신:  python -m scripts.sync_apikeys      (빠진 항목만 덧붙인다)
#   확인:  python -m scripts.sync_apikeys --check
#
# `.env.apikeys` 는 커밋하지 않는다.
#
# ★★여기에 **선언되지 않은 이름을 적으면 앱이 기동조차 못 한다.**
#   `Settings` 가 `extra="forbid"` 라서 `ValidationError` 로 죽는다(2026-09-10 실측).
#   새 키를 넣으려면 `app/core/settings.py` 에 **필드부터 만든다.**
#
# ★읽는 순서: `.env` → `.env.apikeys`. **뒤가 이긴다**(실측 확인).
#   그래서 같은 이름이 양쪽에 있으면 이 파일 값이 쓰인다.
#
# ★비워 두면 그 소스를 **안 붙인다.** 가짜 값으로 채우지 않는다 —
#   Team 은 「모름」으로 escalate 하고, /ui/admin 이 왜 빠졌는지 보여 준다.


# ── 기상 공급자 선택 ─────────────────────────────────────────────
# open_meteo : 키가 **필요 없다**(2026-09-09 실호출 200 확인). 기본값.
#              비상업 하루 10,000 호출 무료라고 공급자가 밝히고 있다 —
#              상업 배포 전 요금제를 다시 확인한다.  https://open-meteo.com/
# kma        : 기상청 단기예보로 바꾼다. 아래 ACOP_KMA_API_KEY 가 필요하다.
ACOP_WEATHER_PROVIDER=open_meteo


# ── 공공데이터포털 공통 인증키 ───────────────────────────────────
# ★계정마다 인증키가 **하나**고, 활용신청을 승인받은 서비스 전부에 같은 키를
#   쓴다. 그래서 **이것만 채우면 아래 서비스가 전부 산다.**
#   서비스별 칸은 **다른 계정을 쓸 때만** 채우는 덮어쓰기 자리다.
#
#   발급: https://www.data.go.kr  가입 → 서비스별 [활용신청] → 마이페이지에서 인증키
#   ★서비스마다 활용신청을 따로 해야 한다. 키는 같아도 승인은 개별이다.
#   ★일반 인증키(Decoding)를 쓴다. Encoding 키를 넣으면 이중 인코딩으로 깨진다.
ACOP_DATA_GO_KR_KEY=


# ── 공공데이터포털 서비스별 (비우면 위 공통 키를 쓴다) ───────────
#
# MVP 에 실제로 필요한 넷 — 2026-09-09 실호출로 엔드포인트 생존 확인(401 = 살아있음)
#
# 한국관광공사 국문 관광정보 — 장소·좌표·운영시간 (read.place 보강)
#   https://www.data.go.kr/data/15101578/openapi.do
ACOP_TOUR_API_KEY=
#
# 한국천문연구원 특일 정보 — ★공휴일 휴무 판정. "그날 여는가"의 절반이다
#   https://www.data.go.kr/data/15012690/openapi.do
ACOP_HOLIDAY_API_KEY=
#
# 기상청 기상특보 — ★지속관리 루프의 트리거. 예보는 당길 때 오고 특보는 사건 때 온다
#   https://www.data.go.kr/data/15000415/openapi.do
ACOP_KMA_WARNING_API_KEY=
#
# 국토교통부 TAGO — 버스·지하철·열차 운행 (read.transit)
#   https://www.data.go.kr/data/15098530/openapi.do   (지하철 15098554 / 열차 별도)
ACOP_TAGO_API_KEY=

# 도메인이 넓어지면 필요한 것들
#
# 기상청 단기예보 — Open-Meteo 대안(국내 정확도). ★2년마다 갱신해야 한다
#   https://www.data.go.kr/data/15084084/openapi.do
ACOP_KMA_API_KEY=
#
# 한국환경공단 에어코리아 — 야외활동 대기질(미세먼지). 개발계정 500/일로 낮다
#   https://www.data.go.kr/data/15073861/openapi.do
ACOP_AIRKOREA_API_KEY=
#
# 국립해양조사원 — ★수상레저(서핑·갯벌·낚시·요트) 활동 성립 판정
#   ★키는 공통 키(ACOP_DATA_GO_KR_KEY)로 충분하다. (구)바다누리 자체
#     OpenAPI 는 **종료 예정**이고 공공데이터포털 쪽을 쓰라고 안내한다.
#     아래는 「어느 서비스에 활용신청할지」를 적어 둔 것이다.
#
#   ★★활용신청할 것 둘 (2026-09-10 조사)
#     ① 서핑지수 조회        data.go.kr/data/15142490   개발 10,000/일 · 자동승인
#        → **활동 성립 여부를 기관이 판정해 준다.** 우리가 조위·풍속에서
#          기준을 만들어 내지 않아도 된다 — 그 기준은 우리 근거가 아니다.
#     ② TideBED 예측 조위(1분) data.go.kr/data/15156026  개발 10,000/일 · 자동승인
#        → ★**위도·경도로 조회된다.** 우리 `places` 에는 좌표만 있고
#          관측소 코드가 없다. 나머지 조석 API 는 전부 관측소 코드를 받는다.
#
#   안 쓰기로 한 것 셋 — 우리 질문에 안 맞는다
#     · 조석예보(고·저조 1일)  15038991 : 고/저조 시각만. 그 사이 시각은 우리가
#       보간해야 하는데, 그 보간은 우리가 지어내는 값이 된다
#     · 최극조위(조석성과)             : 월·연 극값. 해안 구조물 설계용
#     · 조위관측소 실측·예측 비교 15142507 : 모델 검증용. 다만 **예보 신뢰도를
#       실측으로 확인**할 때는 이게 정답이다 — 필요해지면 그때 연다
#
#   `[미확보]` 위 둘의 **정확한 엔드포인트 경로**를 확인하지 못했다.
#     2026-09-10 에 기관코드 1192000 아래로 4개 경로를 추측해 호출했으나 전부
#     400 NO_OPENAPI_SERVICE_ERROR 였다 — **경로를 틀린 것이지 API 가 없는
#     것이 아니다.** 각 데이터 페이지의 「오픈API 활용가이드」(.hwp)에 있다.
ACOP_KHOA_API_KEY=
#
# 국가유산청(옛 문화재청) 국가유산 OpenAPI
#   ★★**키가 필요 없다** — 2026-09-10 실호출 확인. 인증 파라미터를 아예 넣지
#     않고 HTTP 200 + 실제 XML 이 온다. www.khs.go.kr / www.cha.go.kr 둘 다.
#     **그래서 이 칸은 비워 두면 된다.** Open-Meteo 에 이어 두 번째 무키 소스다.
#     붙어 있는 곳: app/infrastructure/travel/heritage.py
#
#   ★주는 것 : 위도·경도 · 주소 · 관리기관 · 시대 · 해설
#     안 주는 것: **관람시간 · 휴무일 · 요금** — 「궁·능 관람 정보」로 읽으면
#     과장이다. 운영시간은 TourAPI detailIntro(키 필요)가 대야 한다.
#
#   ★쓰임은 하나 — **좌표를 모르는 장소의 좌표를 채운다.** 좌표가 없으면
#     read.weather 가 아무것도 못 한다(「어디인지 모르는 곳의 날씨」는 없다).
#
#   이 칸은 공공데이터포털 쪽 문화재 공간정보(data.go.kr/data/3070426)를 따로
#   쓸 때만 채운다. 지금 코드는 그쪽을 안 쓴다.
ACOP_HERITAGE_API_KEY=
#
# 한국공항공사 실시간 운항 — Flight 팀 결항·지연
#   https://www.data.go.kr/data/15113771/openapi.do
#   ★[미확보] 2026-09-09 엔드포인트 경로를 확인하지 못했다(400 NO_OPENAPI_SERVICE_ERROR).
#     키를 넣기 전에 정확한 오퍼레이션 경로를 먼저 확인한다.
ACOP_AIRPORT_API_KEY=
#
# 외교부 국가·지역별 여행경보 — 해외 여행으로 확장할 때
#   https://www.data.go.kr/data/15076237/openapi.do
ACOP_MOFA_API_KEY=
#
# 행정안전부 긴급재난문자 — read.disaster (activity.py 「재난문자 등급 대조」)
#   data.go.kr 목록: https://www.data.go.kr/data/15134001/openapi.do
#   ★실제 호출은 재난안전데이터 공유플랫폼에서: https://www.safetydata.go.kr/
#   ★★[미확보 2026-09-20] 이 공통 키로 되는지, safetydata.go.kr 에 별도 가입이
#     필요한지 확인 안 됐다 — 키를 넣어도 첫 실호출 결과를
#     app/infrastructure/travel/disaster_msg.py 모듈 docstring에 반드시 남긴다.
ACOP_DISASTER_API_KEY=


# ── 민간 (공공데이터포털 키와 **다른 키**다. 공통 키가 대신하지 않는다) ──
#
# ODsay 대중교통 길찾기 — read.route · read.transit
#   https://lab.odsay.com/
#   ★★이 공급자는 **인증 실패에도 HTTP 200 을 준다**(2026-09-09 실측).
#     본문에 [ApiKeyAuthFailed] 가 들어온다. 어댑터가 본문까지 검사하도록
#     해 뒀으니 키가 틀려도 조용히 성공으로 지나가지는 않는다.
ACOP_ODSAY_API_KEY=
#
# 카카오 REST API — 주소 → 좌표 보정 (기상 조회에 좌표가 필요하다)
#   https://developers.kakao.com/
ACOP_KAKAO_REST_API_KEY=

# ── 호출 속도 제한 ───────────────────────────────────────────────
# ★★시험한다고 빨리 두들기면 그날치 한도를 태우고 차단당한다.
#   그래서 **하루 한도를 하루에 걸쳐 쓴다.**
#
#       최소 간격(초) = 86400 / 하루 한도
#       10,000/일 → 8.64초    1,000/일 → 86.4초    500/일 → 172.8초
#
#   간격이 안 찼으면 아래 ACOP_RATE_MAX_WAIT_SECONDS 까지만 기다리고,
#   그래도 모자라면 **거부하고 「모름」으로 넘어간다** — 고객 요청 경로에서
#   86초를 자는 것은 실패보다 나쁘기 때문이다. 거부는 세어서 남는다.
#
#   0 을 넣으면 그 소스는 제한 없음이다. **권하지 않는다.**
#
#   ☆값의 출처를 갈라 적었다:
#     「확인」  공급자 문서/상세페이지에서 실제로 본 수
#     「미확인」 확인 못 해서 data.go.kr 개발계정 통상값으로 보수적으로 잡은 수
#
#   ★한 프로세스 안에서만 센다. 여러 프로세스가 같은 키를 쓰면 합계가 한도를
#     넘을 수 있다 — 중앙 카운터는 아직 없다. 이 한계를 알고 쓴다.

# 확인된 한도
ACOP_RATE_OPEN_METEO_PER_DAY=10000
ACOP_RATE_KMA_WARNING_PER_DAY=10000
ACOP_RATE_KHOA_PER_DAY=10000
ACOP_RATE_AIRKOREA_PER_DAY=500

# 미확인 - 보수적으로 잡았다. 각 서비스 상세페이지에서 확인되면 올린다
ACOP_RATE_TOUR_API_PER_DAY=1000
ACOP_RATE_KASI_HOLIDAY_PER_DAY=1000
ACOP_RATE_TAGO_PER_DAY=1000
ACOP_RATE_KMA_PER_DAY=1000
ACOP_RATE_AIRPORT_PER_DAY=1000
ACOP_RATE_MOFA_PER_DAY=1000
ACOP_RATE_ODSAY_PER_DAY=1000
ACOP_RATE_KAKAO_PER_DAY=1000

# 국가유산청은 키가 없고 공개된 한도도 못 찾았다.
# ★한도를 모른다는 것이 마음껏 두들겨도 된다는 뜻은 아니다. 스스로 조인다.
ACOP_RATE_HERITAGE_KHS_PER_DAY=1000

# 간격이 안 찼을 때 기다려 볼 최대 시간(초). 고객 요청이 여기서 멈춘다.
ACOP_RATE_MAX_WAIT_SECONDS=5.0
