            ot = r.get("ours_transit") or {}
            if "best" in kt and "eta" in ot:
                d = ot["eta"] - kt["best"]["min"]
                tb.append(d)
                tr.append(ot["eta"] - kt["rec"]["min"])
                tm.append(ot["min_option_eta"] - kt["best"]["min"])
                by_bucket.setdefault(r["bucket"], []).append(d)
