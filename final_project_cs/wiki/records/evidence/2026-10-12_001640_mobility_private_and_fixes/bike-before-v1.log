            code = result.get("CODE")
            self.last_error = {"kind": "not_found" if code in (None, "INFO-000", "INFO-200") else "api_error",
                               "code": code}
            return None
        at = _dt.datetime.now().astimezone().isoformat(timespec="minutes")
