+def _boarding_steps(legs, results, midnight, *, observed, rail_service, observation):
+    """재검증의 승차 행만 사용한다. 별도 환승 도보 행에는 승차 시각이 없다."""
+    steps = []
+    for result in results:
+        if result.depart_min is None or result.arrive_min is None:
+            continue
+        idx = result.idx
+        if isinstance(idx, bool) or not isinstance(idx, int) or not 0 <= idx < len(legs):
+            raise ValueError('승차 결과의 구간 번호가 맞지 않는다')
+        leg = legs[idx]
+        mode = leg.get('mode', 'subway')
+        if mode not in ('bus', 'subway'):
+            continue
+        for minute in (result.depart_min, result.arrive_min):
+            if isinstance(minute, bool) or not isinstance(minute, (int, float)) or not 0 <= minute <= SERVICE_DAY_MAX_MIN:
+                raise ValueError('승차 결과 시각이 운행일 범위를 벗어났다')
+        current = idx == 0 and observed
+        step = {'idx': idx, 'mode': mode, 'service': leg.get('route' if mode == 'bus' else 'line'),
+                'from': leg.get('from'), 'to': leg.get('to'),
+                'board_at': (midnight + timedelta(minutes=result.depart_min)).isoformat(),
+                'alight_at': (midnight + timedelta(minutes=result.arrive_min)).isoformat(),
+                'boarding_basis': 'realtime_arrival_prediction' if current else 'timetable_model',
+                'ride_basis': 'model'}
+        if current:
+            # 검증은 보수적으로 분 단위 올림을 쓰지만 안내가 열차 예측보다 늦어져서는 안 된다.
+            step['board_at'] = observation['arrival_at']
+        if current and rail_service is not None:
+            step.update(train_number=observation['train_number'], towards=rail_service['terminal'])
+        steps.append(step)
+    return steps
 
 
