{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.ssh/**)",
      "Read(**/datasets/**)",
      "Read(**/memory/**)",
      "Bash(*.env*)",
      "Bash(*printenv*)",
      "Bash(*set-env*)",
      "Bash(*curl*)",
      "Bash(*wget*)",
      "Bash(*ssh*)",
      "Bash(*git push*)",
      "Bash(*git commit*)"
    ]
  }
}