{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.ssh/**)",
      "Read(**/datasets/**)",
      "Read(**/memory/**)",
      "Edit",
