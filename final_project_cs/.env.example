# A-COP 환경변수 — .env 로 복사해서 채운다. .env 는 커밋하지 않는다.
# ★폴백 금지(RULE.md §3.2): 아래 값이 없으면 예외를 던지고 멈춘다. 기본값으로 조용히 대체하지 않는다.

# ── DB ───────────────────────────────────────────────────────
# PostgreSQL 16.14 (conda env `pgv`, Windows 서비스 아님 — docs/manuals/ 참조)
ACOP_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/acop_cs

# ── LLM ──────────────────────────────────────────────────────
ACOP_LLM_PROVIDER=openai
ACOP_OPENAI_API_KEY=
ACOP_LLM_MODEL=gpt-4o-mini
# 임베딩 차원은 config/guardrails.yaml (rag.embedding_dim=1536) 과 DDL vector(1536) 이 함께 정한다.
# 모델을 바꾸면 DDL 과 적재분도 함께 바꿔야 한다.
ACOP_EMBEDDING_MODEL=text-embedding-3-small
# 정책 검색(RAG)의 임베딩을 어디서 만드나 — openai | ollama
#  ★openai 는 위 모델(1536차원, `embedding` 칸), ollama 는 bge-m3(1024차원, `embedding_1024` 칸).
#    고른 쪽 칸이 비어 있으면 검색이 예외를 낸다 — 조용히 다른 칸으로 넘어가지 않는다.
#    ollama 로 쓰려면 `python -m scripts.embed_chunks_local` 로 칸을 먼저 채운다.
ACOP_EMBEDDING_PROVIDER=openai
ACOP_OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# 평가 재현성 — 실행 조건은 리포트에 그대로 적는다(RULE.md §1.4)
ACOP_LLM_TEMPERATURE=0.0
ACOP_LLM_SEED=7

# ── 앱 ───────────────────────────────────────────────────────
ACOP_ENV=dev
ACOP_TENANT_ID=demo
# 감사·API key hashing 용. 운영에서는 반드시 교체한다.
ACOP_SECRET_KEY=change-this-to-a-long-random-secret
ACOP_COMPOSER_JWT_SECRET=replace-with-a-long-random-composer-signing-secret
ACOP_COMPOSER_ISSUER_SECRET=replace-with-a-long-random-composer-issuer-secret

# ── 경로 ─────────────────────────────────────────────────────
ACOP_GUARDRAILS_PATH=config/guardrails.yaml

# ── 여행 외부 소스 ───────────────────────────────────────────
# ★키는 이 파일이 아니라 **`.env.apikeys`** 에 넣는다(2026-09-10 분리).
#   형식과 발급처 링크는 `.env.apikeys.example` 에 있다.
#   읽는 순서는 `.env` → `.env.apikeys` 이고 **뒤가 이긴다**.
#
#   따로 둔 이유: 팀원마다 발급 상태가 다르고 승인 대기 중인 키가 섞이면
#   `.env` 전체를 주고받게 된다. 키만 갈아끼울 수 있어야 한다.
